MAIN_GPU=0
NGROK_TOKEN=
EZLOCALAI_API_KEY=change-me
EZLOCALAI_URL=http://localhost:8091
DEFAULT_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF
QUANT_TYPE=Q3_K_XL
IMG_MODEL=
WHISPER_MODEL=
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=
WHISPER_CPP_MODEL_PATH=
WHISPER_CPP_MODEL_DIR=/app/whispercpp/models
WHISPER_CPP_EXTRA_ARGS=
WHISPER_CPP_TIMEOUT=600
PDFTOTEXT_BIN=/usr/bin/pdftotext
PDFTOTEXT_TIMEOUT=60
MAX_CONCURRENT_REQUESTS=2
N_PARALLEL=1
MAX_QUEUE_SIZE=100
REQUEST_TIMEOUT=300
VOICE_SERVER=https://voice.ezlocal.ai
LLM_MAX_TOKENS=262144
# Optional native overrides; leave blank to honor LLM_MAX_TOKENS.
LLAMA_CPP_CONTEXT=
LLAMA_CPP_DEFAULT_CONTEXT=
LLM_BATCH_SIZE=auto
LLM_UBATCH_SIZE=auto
KV_CACHE_TYPE=q4_0
LLAMA_CPP_FLASH_ATTENTION=true
EZLOCALAI_PRELOAD_MODEL_ON_START=true
EZLOCALAI_LLAMA_CPP_CMAKE_ARGS=-DGGML_CUDA=ON -DLLAMA_CURL=ON -DCMAKE_CUDA_ARCHITECTURES=86 -DCMAKE_EXE_LINKER_FLAGS=-Wl,-rpath-link,/usr/local/cuda/lib64/stubs
EZLOCALAI_LLAMA_CPP_JOBS=
LLAMA_CPP_START_TIMEOUT=3600
# Optional private NVIDIA MPS server for concurrent GPU model processes. Default off.
# Requires nvidia-cuda-mps-control; do not combine with external MPS pipe/log settings.
EZLOCALAI_CUDA_MPS=false
# Optional per-DEFAULT_MODEL priorities: 0 normal (voice), 1 below normal (helper).
# Empty entries inherit CUDA_MPS_CLIENT_PRIORITY. Calls/helpers prefer matching copies.
LLM_CUDA_MPS_CLIENT_PRIORITY=
ROUTER_URL=https://router.ezlocal.ai
# Opt in to router request gzip after benchmarking this worker's link. Default: false.
EZLOCALAI_ROUTER_REQUEST_GZIP=false
WORKER_LABEL=bird
WORKER_TUNNEL=true

# Optional local music; the CUDA image includes the pinned ACE-Step server.
MUSIC_ENABLED=false
MUSIC_MODEL=Serveurperso/ACE-Step-1.5-GGUF
ACE_STEP_SERVER_URL=
ACE_STEP_AUTO_START=true
ACE_STEP_BIN=/opt/acestep.cpp/build/ace-server
ACE_STEP_MODELS_DIR=models/ace-step
ACE_STEP_MODEL_REPO=Serveurperso/ACE-Step-1.5-GGUF
ACE_STEP_PRECACHE=true
# Set to 2 or more to allow multiple generated tracks per request.
ACE_STEP_MAX_BATCH=1
MUSIC_UNLOAD_LLM_DURING_GENERATION=auto
MUSIC_RELOAD_LLM_AFTER_GENERATION=true
