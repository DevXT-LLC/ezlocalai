--- /dev/null
+++ b/src/ltx_timesteps.hpp
@@ -0,0 +1,17 @@
+#pragma once
+#include <ggml.h>
+#include <utility>
+
+// The ezlocalai Diffusers pipelines pass scheduler timesteps to all AdaLN
+// modules. Their default use_cross_timestep=false keeps the video token mask.
+inline std::pair<ggml_tensor*, ggml_tensor*> ltx_av_cross_timesteps(
+    ggml_context* ctx, ggml_tensor* video_sigma, ggml_tensor* audio_sigma,
+    float multiplier, bool python_diffusers) {
+    if (python_diffusers) {
+        return {ggml_scale(ctx, video_sigma, multiplier), ggml_scale(ctx, audio_sigma, multiplier)};
+    }
+    GGML_ASSERT(audio_sigma->ne[0] == 1 || audio_sigma->ne[0] == video_sigma->ne[0]);
+    auto video = audio_sigma->ne[0] == video_sigma->ne[0] ? audio_sigma
+        : ggml_repeat(ctx, audio_sigma, ggml_new_tensor_1d(ctx, audio_sigma->type, video_sigma->ne[0]));
+    return {video, audio_sigma};
+}
