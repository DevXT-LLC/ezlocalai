+namespace {
+
+// Blobs expose their immutable backing through const data(). Distinct nonempty
+// vectors cannot have the same address, including across target/draft fields.
+bool prompt_has_blob_before(const server_prompt & prompt, const common_state_blob & blob,
+        const common_state_blob * before = nullptr) {
+    for (const auto & checkpoint : prompt.checkpoints) {
+        for (const auto * current : {&checkpoint.data_tgt, &checkpoint.data_dft}) {
+            if (current == before) return false;
+            if (!current->empty() && current->data() == blob.data()) return true;
+        }
+    }
+    return false;
+}
+
+bool cache_has_blob_before(const std::list<server_prompt_cache_state> * states,
+        const server_prompt_cache_state * only, const server_prompt_cache_state * before,
+        const common_state_blob & blob) {
+    if (states != nullptr) {
+        for (const auto & state : *states) {
+            if (&state == before) break;
+            if (only != nullptr && &state != only) continue;
+            if (prompt_has_blob_before(state.prompt, blob)) return true;
+        }
+    }
+    return false;
+}
+
+// Count backing allocations retained by cached prompts, plus an optional prompt
+// about to be cloned. Live-slot-only checkpoints remain outside the cache budget.
+// The small cache needs no allocating identity set, so accounting stays usable
+// while handling allocation failures. CPU speculative vectors are never shared.
+size_t prompt_cache_bytes(const std::list<server_prompt_cache_state> * states,
+        const server_prompt_cache_state * only = nullptr,
+        const server_prompt * incoming = nullptr, size_t incoming_data = 0) {
+    size_t result = incoming_data;
+    const auto add_prompt = [&](const server_prompt & prompt,
+            const server_prompt_cache_state * before, bool shares_storage) {
+        size_t bytes = 0;
+        for (const auto & checkpoint : prompt.checkpoints) {
+            bytes += checkpoint.data_spec.capacity();
+            for (const auto * blob : {&checkpoint.data_tgt, &checkpoint.data_dft}) {
+                if (blob->empty()) continue;
+                if (shares_storage && (cache_has_blob_before(states, only, before, *blob) ||
+                        prompt_has_blob_before(prompt, *blob, blob))) continue;
+                bytes += blob->capacity();
+            }
+        }
+        return bytes;
+    };
+    if (states != nullptr) {
+        for (const auto & state : *states) {
+            if (only != nullptr && &state != only) continue;
+            result += state.data.size() + add_prompt(state.prompt, &state, true);
+        }
+    }
+    if (incoming != nullptr) {
+        // With storage disabled, copying each incoming field allocates its own
+        // vector even if the source still shares backing from an earlier save.
+        result += add_prompt(*incoming, nullptr, common_state_storage_enabled());
+    }
+    return result;
+}
+
