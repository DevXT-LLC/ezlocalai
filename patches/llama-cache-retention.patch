diff --git a/common/checkpoint-retention.h b/common/checkpoint-retention.h
new file mode 100644
--- /dev/null
+++ b/common/checkpoint-retention.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+enum class common_checkpoint_erasure {
+    superseded,
+    too_close,
+    oldest,
+};
+
+// Remove same-boundary entries before reserving capacity for their replacement,
+// so a refresh cannot cause an unnecessary oldest-entry eviction. The existing
+// min-step cleanup and current-task exception still apply to the remaining list.
+// The callback keeps logging outside this allocation-free list policy.
+template <typename Checkpoints, typename OnErase>
+inline void common_prepare_checkpoint_admission(
+        Checkpoints & checkpoints, int64_t n_tokens, int id_task,
+        size_t max_checkpoints, int64_t min_step, OnErase on_erase) {
+    for (auto it = checkpoints.begin(); it != checkpoints.end();) {
+        if (it->n_tokens == n_tokens) {
+            on_erase(common_checkpoint_erasure::superseded, *it);
+            it = checkpoints.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    // Preserve the existing min-step policy and current-task exception.
+    int64_t last = -1;
+    for (auto it = checkpoints.begin();
+            checkpoints.size() + 1 >= max_checkpoints && it != checkpoints.end();) {
+        if (it->id_task != id_task && last >= 0 && it->n_tokens <= last + min_step) {
+            on_erase(common_checkpoint_erasure::too_close, *it);
+            it = checkpoints.erase(it);
+            continue;
+        }
+        last = it->n_tokens;
+        ++it;
+    }
+
+    while (!checkpoints.empty() && checkpoints.size() >= max_checkpoints) {
+        on_erase(common_checkpoint_erasure::oldest, checkpoints.front());
+        checkpoints.erase(checkpoints.begin());
+    }
+}
