+++ b/src/pipeline/ltx_condition.hpp
@@ -0,0 +1,144 @@
+#pragma once
+#include <algorithm>
+#include <cassert>
+#include <cmath>
+#include <optional>
+#include "core/tensor.hpp"
+#include "stable-diffusion.h"
+
+namespace sd::pipeline {
+    inline std::optional<int64_t> ltx_condition_index(int64_t index, int64_t frames) {
+        if (frames <= 0) return std::nullopt;
+        if (index < 0) index = (index % frames + frames) % frames;
+        if (index >= frames) return std::nullopt;
+        return index;
+    }
+    inline float ltxv_latent_corner_to_pixel_frame(int64_t corner_index,
+                                                   int temporal_scale,
+                                                   bool causal_temporal_positioning) {
+        float pixel_t = static_cast<float>(corner_index * temporal_scale);
+        if (causal_temporal_positioning) {
+            pixel_t = std::max(0.f, pixel_t + 1.f - static_cast<float>(temporal_scale));
+        }
+        return pixel_t;
+    }
+
+    inline void set_ltxv_video_position(sd::Tensor<float>* positions,
+                                        int64_t token,
+                                        float t_start,
+                                        float t_end,
+                                        float h_start,
+                                        float h_end,
+                                        float w_start,
+                                        float w_end) {
+        positions->index(0, 0, token, 0) = t_start;
+        positions->index(1, 0, token, 0) = t_end;
+        positions->index(0, 1, token, 0) = h_start;
+        positions->index(1, 1, token, 0) = h_end;
+        positions->index(0, 2, token, 0) = w_start;
+        positions->index(1, 2, token, 0) = w_end;
+    }
+
+    inline sd::Tensor<float> build_ltxv_video_positions(int64_t width,
+                                                        int64_t height,
+                                                        int64_t target_latent_frames,
+                                                        int64_t keyframe_latent_frames,
+                                                        int keyframe_frame_idx,
+                                                        int keyframe_pixel_frames,
+                                                        int fps,
+                                                        int spatial_scale,
+                                                        int temporal_scale,
+                                                        bool causal_temporal_positioning) {
+        assert(width > 0 && height > 0 && target_latent_frames > 0);
+        assert(keyframe_latent_frames > 0);
+        assert(fps > 0);
+
+        int64_t total_tokens = width * height * (target_latent_frames + keyframe_latent_frames);
+        sd::Tensor<float> positions({2, 3, total_tokens, 1});
+        int64_t token = 0;
+
+        for (int64_t t = 0; t < target_latent_frames; t++) {
+            float t_start = ltxv_latent_corner_to_pixel_frame(t, temporal_scale, causal_temporal_positioning) / static_cast<float>(fps);
+            float t_end   = ltxv_latent_corner_to_pixel_frame(t + 1, temporal_scale, causal_temporal_positioning) / static_cast<float>(fps);
+            for (int64_t h = 0; h < height; h++) {
+                float h_start = static_cast<float>(h * spatial_scale);
+                float h_end   = static_cast<float>((h + 1) * spatial_scale);
+                for (int64_t w = 0; w < width; w++) {
+                    float w_start = static_cast<float>(w * spatial_scale);
+                    float w_end   = static_cast<float>((w + 1) * spatial_scale);
+                    set_ltxv_video_position(&positions, token++, t_start, t_end, h_start, h_end, w_start, w_end);
+                }
+            }
+        }
+
+        for (int64_t t = 0; t < keyframe_latent_frames; t++) {
+            float t_start = static_cast<float>(keyframe_frame_idx + t * temporal_scale);
+            float t_end   = static_cast<float>(keyframe_frame_idx + (t + 1) * temporal_scale);
+            if (keyframe_pixel_frames == 1) {
+                t_end = t_start + 1.f;
+            }
+            t_start /= static_cast<float>(fps);
+            t_end /= static_cast<float>(fps);
+            for (int64_t h = 0; h < height; h++) {
+                float h_start = static_cast<float>(h * spatial_scale);
+                float h_end   = static_cast<float>((h + 1) * spatial_scale);
+                for (int64_t w = 0; w < width; w++) {
+                    float w_start = static_cast<float>(w * spatial_scale);
+                    float w_end   = static_cast<float>((w + 1) * spatial_scale);
+                    set_ltxv_video_position(&positions, token++, t_start, t_end, h_start, h_end, w_start, w_end);
+                }
+            }
+        }
+
+        return positions;
+    }
+
+    inline sd::Tensor<float> ltx_condition_pixels(const sd_image_t& image, int width, int height) {
+        if (!image.data || image.channel != 3 || !image.width || !image.height || width <= 0 || height <= 0) return {};
+        const double scale = std::max(double(width) / image.width, double(height) / image.height);
+        const int resized_w = static_cast<int>(std::ceil(image.width * scale));
+        const int resized_h = static_cast<int>(std::ceil(image.height * scale));
+        const int left = (resized_w - width) / 2, top = (resized_h - height) / 2;
+        const float sx = float(image.width) / resized_w, sy = float(image.height) / resized_h;
+        sd::Tensor<float> result({width, height, 3, 1});
+        for (int y = 0; y < height; ++y) {
+            const float source_y = std::max(0.f, (y + top + .5f) * sy - .5f);
+            const int y0 = int(source_y), y1 = std::min(y0 + 1, int(image.height) - 1);
+            const float fy = source_y - y0;
+            for (int x = 0; x < width; ++x) {
+                const float source_x = std::max(0.f, (x + left + .5f) * sx - .5f);
+                const int x0 = int(source_x), x1 = std::min(x0 + 1, int(image.width) - 1);
+                const float fx = source_x - x0;
+                for (int c = 0; c < 3; ++c) {
+                    const auto pixel = [&](int px, int py) { return float(image.data[(size_t(py) * image.width + px) * 3 + c]); };
+                    const float a = pixel(x0,y0) * (1.f-fx) + pixel(x1,y0) * fx;
+                    const float b = pixel(x0,y1) * (1.f-fx) + pixel(x1,y1) * fx;
+                    result.index(x,y,c,0) = (a * (1.f-fy) + b * fy) / 255.f;
+                }
+            }
+        }
+        return result;
+    }
+
+    inline bool append_ltx_keyframe(sd::Tensor<float>& latent, sd::Tensor<float>& mask,
+                                   sd::Tensor<float>& positions, int64_t target_frames,
+                                   int64_t& conditioning_frames, const sd::Tensor<float>& keyframe,
+                                   int pixel_index, float mask_value, int fps, int spatial_scale) {
+        if (keyframe.empty() || keyframe.shape()[2] <= 0 ||
+            keyframe.shape()[0] != latent.shape()[0] || keyframe.shape()[1] != latent.shape()[1] ||
+            keyframe.shape()[3] != latent.shape()[3]) return false;
+        auto keyframe_mask = sd::full<float>({keyframe.shape()[0],keyframe.shape()[1],keyframe.shape()[2],1,1}, mask_value);
+        auto next_positions = build_ltxv_video_positions(keyframe.shape()[0],keyframe.shape()[1],target_frames,
+            keyframe.shape()[2],pixel_index,1,fps,spatial_scale,8,true);
+        if (!positions.empty()) {
+            const int64_t base_tokens = keyframe.shape()[0] * keyframe.shape()[1] * target_frames;
+            next_positions = sd::ops::concat(positions,
+                sd::ops::slice(next_positions,2,base_tokens,next_positions.shape()[2]),2);
+        }
+        latent = sd::ops::concat(latent,keyframe,2);
+        mask = sd::ops::concat(mask,keyframe_mask,2);
+        positions = std::move(next_positions);
+        conditioning_frames += keyframe.shape()[2];
+        return true;
+    }
+}
