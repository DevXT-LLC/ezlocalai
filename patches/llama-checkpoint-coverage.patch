diff --git a/common/checkpoint-coverage.h b/common/checkpoint-coverage.h
new file mode 100644
index 0000000..27c2351
--- /dev/null
+++ b/common/checkpoint-coverage.h
@@ -0,0 +1,95 @@
+#pragma once
+
+#include "llama.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+inline bool common_checkpoint_coverage_enabled() {
+    const char * value = std::getenv("EZLOCALAI_LLAMA_CHECKPOINT_COVERAGE");
+    return value == nullptr || std::strcmp(value, "0") != 0;
+}
+
+template <typename Tokens>
+inline bool common_checkpoint_prompt_is_text_only(const Tokens & tokens) {
+    // OAI chat tokenization sets has_mtmd whenever a projector is loaded,
+    // including requests containing only text. Inspect the actual media map.
+    // find_next_media_chunk() uses upper_bound, so check index zero separately.
+    return tokens.empty() || (tokens[0] != LLAMA_TOKEN_NULL &&
+            tokens.find_next_media_chunk(0).first == nullptr);
+}
+
+struct common_checkpoint_plan {
+    std::array<int32_t, 2> offsets{};
+    size_t count = 0;
+    int32_t old_near_span = 0;
+    int32_t logical_batch = 0;
+    int32_t extra_window_end = 0;
+    uint32_t rollback_tail = 0;
+
+    bool break_before_end(int64_t remaining, int64_t added = 0, int64_t remaining_before = 0) const {
+        for (size_t i = 0; i < count; ++i) if (remaining == offsets[i]) return true;
+        if (extra_window_end > 0 && remaining > offsets[0] && remaining <= extra_window_end &&
+                added > 0 && added % old_near_span == 0) {
+            // Match an ORIGINAL physical boundary, not an absolute prompt
+            // offset. The original target splitter reserves its RS tail;
+            // splitting immediately before a shorter tail would rephase it.
+            const int64_t legacy_chunk = std::min<int64_t>(logical_batch, remaining_before - offsets[0]);
+            return legacy_chunk - added >= rollback_tail;
+        }
+        return false;
+    }
+    bool near_end(int64_t remaining_after, int64_t remaining_before) const {
+        // The extra window is one physical batch wide. Once reached, the next
+        // original split ends the window, so at most one snapshot is added.
+        return remaining_after < old_near_span ||
+            (extra_window_end > 0 && remaining_before > offsets[0] &&
+             remaining_before <= extra_window_end && remaining_after <= offsets[0]);
+    }
+};
+
+struct common_checkpoint_runtime {
+    size_t slots = 0;
+    uint32_t draft_ubatch = 0;
+    uint32_t rollback_tokens = 0;
+    bool single_mtp_head = false;
+    // No later user-start, LoRA switch or shared-parent boundary may shorten
+    // the original logical chunk used for the physical-alignment proof.
+    bool uninterrupted_last_user = false;
+};
+
+inline common_checkpoint_plan common_plan_checkpoints(
+        int64_t prompt_tokens, int32_t n_batch, int32_t n_ubatch,
+        int32_t max_checkpoints, bool named_text_prompt, bool recurrent_checkpoint,
+        const common_checkpoint_runtime & runtime,
+        bool enabled = common_checkpoint_coverage_enabled()) {
+    common_checkpoint_plan plan;
+    plan.old_near_span = std::max(0, n_ubatch);
+    plan.logical_batch = n_batch;
+    if (n_batch <= 0 || n_ubatch <= 0) return plan;
+    const auto bounded = [n_batch](int64_t offset) { return int32_t(std::min<int64_t>(n_batch, offset)); };
+    const auto add = [&](int32_t offset) {
+        for (size_t i = 0; i < plan.count; ++i) if (plan.offsets[i] == offset) return false;
+        plan.offsets[plan.count++] = offset;
+        return true;
+    };
+    // These two original offsets always remain, including with the opt-out.
+    add(bounded(int64_t(n_ubatch) + 4));
+    add(bounded(4));
+    // This experiment is deliberately limited to the measured fleet's 1024
+    // path. Other physical sizes, multiple slots/heads and custom draft batch
+    // sizes retain the exact original scheduler.
+    if (enabled && named_text_prompt && recurrent_checkpoint && prompt_tokens >= 4096 &&
+            max_checkpoints >= 4 && runtime.slots == 1 && n_ubatch == 1024 &&
+            runtime.draft_ubatch == uint32_t(n_ubatch) && runtime.single_mtp_head &&
+            runtime.uninterrupted_last_user && runtime.rollback_tokens < uint32_t(n_ubatch - 1) &&
+            n_batch >= 2*n_ubatch) {
+        plan.extra_window_end = bounded(2*int64_t(n_ubatch) + 4);
+        plan.rollback_tail = runtime.rollback_tokens > 0 ? runtime.rollback_tokens + 1 : 1;
+    }
+    std::sort(plan.offsets.begin(), plan.offsets.begin() + plan.count, [](int32_t a, int32_t b) { return a > b; });
+    return plan;
+}
