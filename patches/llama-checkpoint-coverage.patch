diff --git a/common/checkpoint-coverage.h b/common/checkpoint-coverage.h
new file mode 100644
index 0000000..88b8ca8
--- /dev/null
+++ b/common/checkpoint-coverage.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+inline bool common_checkpoint_coverage_enabled() {
+    const char * value = std::getenv("EZLOCALAI_LLAMA_CHECKPOINT_COVERAGE");
+    return value == nullptr || std::strcmp(value, "0") != 0;
+}
+
+struct common_checkpoint_plan {
+    std::array<int32_t, 3> offsets{};
+    size_t count = 0;
+    int32_t old_near_span = 0;
+    int32_t extra_offset = 0;
+    int32_t extra_near_span = 0;
+
+    bool break_before_end(int64_t remaining) const {
+        for (size_t i = 0; i < count; ++i) if (remaining == offsets[i]) return true;
+        return false;
+    }
+    bool near_end(int64_t remaining_after, int64_t remaining_before) const {
+        // Preserve ordinary near-end behavior. The expanded span permits only
+        // the ONE added snapshot, not unrelated user-message/batch boundaries.
+        return remaining_after < old_near_span ||
+            (extra_offset > 0 && remaining_before == extra_offset && remaining_after < extra_near_span);
+    }
+};
+
+inline common_checkpoint_plan common_plan_checkpoints(
+        int64_t prompt_tokens, int32_t n_batch, int32_t n_ubatch,
+        int32_t max_checkpoints, bool named_text_prompt, bool recurrent_checkpoint,
+        bool enabled = common_checkpoint_coverage_enabled()) {
+    common_checkpoint_plan plan;
+    plan.old_near_span = std::max(0, n_ubatch);
+    if (n_batch <= 0 || n_ubatch <= 0) return plan;
+    const auto bounded = [n_batch](int64_t offset) { return int32_t(std::min<int64_t>(n_batch, offset)); };
+    const auto add = [&](int32_t offset) {
+        for (size_t i = 0; i < plan.count; ++i) if (plan.offsets[i] == offset) return false;
+        plan.offsets[plan.count++] = offset;
+        return true;
+    };
+    // These two original offsets always remain, including with the opt-out.
+    add(bounded(int64_t(n_ubatch) + 4));
+    add(bounded(4));
+    if (enabled && named_text_prompt && recurrent_checkpoint &&
+            prompt_tokens >= 4096 && max_checkpoints >= 4) {
+        const int32_t extra = bounded(std::max<int64_t>(n_ubatch, 2048) + 4);
+        if (add(extra)) {
+            plan.extra_offset = extra;
+            plan.extra_near_span = std::max(n_ubatch, extra - 4);
+        }
+    }
+    std::sort(plan.offsets.begin(), plan.offsets.begin() + plan.count, [](int32_t a, int32_t b) { return a > b; });
+    return plan;
+}
