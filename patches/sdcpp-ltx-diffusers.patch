@@ -0,0 +1,16 @@
+#pragma once
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+namespace sd {
+// Installed Diffusers uses double arithmetic and Python round (ties to even).
+inline int ltx_audio_latents(int frames, int fps) {
+    if (frames <= 0 || fps <= 0) throw std::invalid_argument("LTX frames and fps must be positive");
+    const double value = (static_cast<double>(frames) / fps) * (16000.0 / 160.0 / 4.0);
+    double rounded = std::floor(value);
+    const double fraction = value - rounded;
+    if (fraction > 0.5 || (fraction == 0.5 && std::fmod(rounded, 2.0) != 0)) ++rounded;
+    if (rounded > std::numeric_limits<int>::max()) throw std::overflow_error("LTX audio latent count exceeds native range");
+    return static_cast<int>(rounded);
+}
+}
