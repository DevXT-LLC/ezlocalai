+#pragma once
+#include <string>
+#include <utility>
+#include <vector>
+
+// Names only: keep the published tensor bytes, shapes and precision intact.
+// The explicit loader namespace prevents these rules from affecting other
+// models or already-converted LTX checkpoints.
+inline std::string ltx_diffusers_tensor_name(const std::string& component, std::string name) {
+    const auto replace = [&](const std::string& from, const std::string& to) {
+        const auto pos = name.find(from);
+        if (pos != std::string::npos) name.replace(pos,from.size(),to);
+    };
+    if (component == "text_encoder") {
+        const std::string prefix = "language_model.model.";
+        if (name.rfind(prefix,0) != 0) return "unused.ltx.text_encoder." + name;
+        name.erase(0,prefix.size());
+        // Gemma3's GGML implementation uses the GGUF norm names.
+        if (name.find(".post_attention_layernorm.") != std::string::npos) replace(".post_attention_layernorm.",".post_attention_norm.");
+        else if (name.find(".pre_feedforward_layernorm.") != std::string::npos) replace(".pre_feedforward_layernorm.",".post_attention_layernorm.");
+        else replace(".post_feedforward_layernorm.",".post_ffw_norm.");
+        return "text_encoders.llm.model." + name;
+    }
+    if (component == "connectors") {
+        for (const std::string modality : {"video","audio"}) {
+            const auto projection = modality + "_text_proj_in.";
+            if (name.rfind(projection,0) == 0)
+                return "text_embedding_projection." + modality + "_aggregate_embed." + name.substr(projection.size());
+            const auto connector = modality + "_connector.";
+            if (name.rfind(connector,0) == 0) {
+                name.erase(0,connector.size());
+                replace("transformer_blocks.","transformer_1d_blocks.");
+                replace(".norm_q.",".q_norm."); replace(".norm_k.",".k_norm.");
+                return "model.diffusion_model." + modality + "_embeddings_connector." + name;
+            }
+        }
+    }
+    if (component == "vae") {
+        // Inverse of the installed convert_ltx2_vae_to_diffusers mapping.
+        // Match one block prefix before replacing common suffixes.
+        const std::vector<std::pair<std::string,std::string>> blocks = {
+            {"encoder.down_blocks.0.downsamplers.0.","encoder.down_blocks.1."},
+            {"encoder.down_blocks.1.downsamplers.0.","encoder.down_blocks.3."},
+            {"encoder.down_blocks.2.downsamplers.0.","encoder.down_blocks.5."},
+            {"encoder.down_blocks.3.downsamplers.0.","encoder.down_blocks.7."},
+            {"encoder.down_blocks.0.","encoder.down_blocks.0."},
+            {"encoder.down_blocks.1.","encoder.down_blocks.2."},
+            {"encoder.down_blocks.2.","encoder.down_blocks.4."},
+            {"encoder.down_blocks.3.","encoder.down_blocks.6."},
+            {"encoder.mid_block.","encoder.down_blocks.8."},
+            {"decoder.up_blocks.0.upsamplers.0.","decoder.up_blocks.1."},
+            {"decoder.up_blocks.1.upsamplers.0.","decoder.up_blocks.3."},
+            {"decoder.up_blocks.2.upsamplers.0.","decoder.up_blocks.5."},
+            {"decoder.up_blocks.3.upsamplers.0.","decoder.up_blocks.7."},
+            {"decoder.up_blocks.0.","decoder.up_blocks.2."},
+            {"decoder.up_blocks.1.","decoder.up_blocks.4."},
+            {"decoder.up_blocks.2.","decoder.up_blocks.6."},
+            {"decoder.up_blocks.3.","decoder.up_blocks.8."},
+            {"decoder.mid_block.","decoder.up_blocks.0."}
+        };
+        for (const auto& mapping : blocks) if (name.rfind(mapping.first,0) == 0) {
+            name = mapping.second + name.substr(mapping.first.size()); break;
+        }
+        replace(".resnets.",".res_blocks.");
+        if (name == "latents_mean") name = "per_channel_statistics.mean-of-means";
+        if (name == "latents_std") name = "per_channel_statistics.std-of-means";
+        return "first_stage_model." + name;
+    }
+    if (component == "audio_vae") {
+        if (name == "latents_mean") name = "per_channel_statistics.mean-of-means";
+        if (name == "latents_std") name = "per_channel_statistics.std-of-means";
+        return "audio_vae." + name;
+    }
+    if (component == "vocoder") {
+        replace(".conv_in.",".conv_pre."); replace(".conv_out.",".conv_post.");
+        replace(".act_out.",".act_post."); replace(".upsamplers.",".ups.");
+        replace(".resnets.",".resblocks."); replace(".downsample.filter",".downsample.lowpass.filter");
+        return "vocoder." + name;
+    }
+    return "unused.ltx." + component + "." + name;
+}
