+
+extern "C" GGML_BACKEND_API void ggml_cuda_fattn_q4_kv_get_stats(ggml_cuda_fattn_q4_kv_stats * result) {
+    if (result == nullptr) return;
+#define GGML_Q4_KV_GET_FIELD(name) result->name = q4_kv_stats.name.load(std::memory_order_relaxed);
+    GGML_Q4_KV_STATS_FIELDS(GGML_Q4_KV_GET_FIELD)
+#undef GGML_Q4_KV_GET_FIELD
+}
+
+void ggml_cuda_fattn_q4_kv_record_dispatch(bool fused, bool fallback, int baseline, int candidate) {
+    q4_kv_stats.eligible_calls.fetch_add(1, std::memory_order_relaxed);
+    if (fused) q4_kv_stats.fused_calls.fetch_add(1, std::memory_order_relaxed);
+    if (fallback) q4_kv_stats.occupancy_fallbacks.fetch_add(1, std::memory_order_relaxed);
+    q4_kv_stats.baseline_blocks_per_sm.store(baseline, std::memory_order_relaxed);
+    q4_kv_stats.candidate_blocks_per_sm.store(candidate, std::memory_order_relaxed);
