+#include <atomic>
+#include <cstdio>
+
+namespace {
+
+#define GGML_Q4_KV_STATS_FIELDS(X) \
+    X(eligible_calls) X(fused_calls) X(occupancy_fallbacks) \
+    X(baseline_blocks_per_sm) X(candidate_blocks_per_sm) \
+    X(grid_x) X(grid_y) X(grid_z) X(block_x) X(block_y) X(block_z) \
+    X(shared_bytes) X(kv_rows) X(query_rows) X(tile_rows) X(output_tiles) X(stream_k)
+
+struct q4_kv_atomic_stats {
+#define GGML_Q4_KV_ATOMIC_FIELD(name) std::atomic<uint64_t> name{0};
+    GGML_Q4_KV_STATS_FIELDS(GGML_Q4_KV_ATOMIC_FIELD)
+#undef GGML_Q4_KV_ATOMIC_FIELD
+};
+
+q4_kv_atomic_stats q4_kv_stats;
+std::atomic<bool> q4_kv_exit_dump_registered{false};
+
+static void q4_kv_dump_at_exit() {
+    ggml_cuda_fattn_q4_kv_stats value;
+    ggml_cuda_fattn_q4_kv_get_stats(&value);
+    // Host selections include graph capture, not GPU graph replays. These
+    // diagnostic snapshots are individually atomic, not transactionally paired.
+    std::fprintf(stderr,
+            "ezlocalai_q4_kv_fusion_stats {\"kind\":\"host_dispatch_selections\","
+            "\"eligible\":%llu,\"selected\":%llu,\"occupancy_fallbacks\":%llu,"
+            "\"baseline_blocks_per_sm\":%llu,\"candidate_blocks_per_sm\":%llu,"
+            "\"grid\":[%llu,%llu,%llu],\"block\":[%llu,%llu,%llu],"
+            "\"shared_bytes\":%llu,\"kv_rows\":%llu,\"query_rows\":%llu,"
+            "\"tile_rows\":%llu,\"output_tiles\":%llu,\"stream_k\":%llu}\n",
+            (unsigned long long) value.eligible_calls, (unsigned long long) value.fused_calls,
+            (unsigned long long) value.occupancy_fallbacks,
+            (unsigned long long) value.baseline_blocks_per_sm, (unsigned long long) value.candidate_blocks_per_sm,
+            (unsigned long long) value.grid_x, (unsigned long long) value.grid_y, (unsigned long long) value.grid_z,
+            (unsigned long long) value.block_x, (unsigned long long) value.block_y, (unsigned long long) value.block_z,
+            (unsigned long long) value.shared_bytes, (unsigned long long) value.kv_rows, (unsigned long long) value.query_rows,
+            (unsigned long long) value.tile_rows, (unsigned long long) value.output_tiles, (unsigned long long) value.stream_k);
