+
+} // namespace
+
+extern "C" GGML_BACKEND_API void ggml_cuda_fattn_q4_kv_reset_stats() {
+#define GGML_Q4_KV_RESET_FIELD(name) q4_kv_stats.name.store(0, std::memory_order_relaxed);
