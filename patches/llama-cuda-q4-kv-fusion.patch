diff --git a/ggml/src/ggml-cuda/fattn-q4-kv-policy.h b/ggml/src/ggml-cuda/fattn-q4-kv-policy.h
new file mode 100644
index 000000000..c86295f19
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-q4-kv-policy.h
@@ -0,0 +1,145 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <limits>
+
+// Host-only metadata: CPU guards and the CUDA dispatcher exercise one policy.
+// The byte range is the tensor's logical span, not the backing buffer size.
+struct ggml_cuda_q4_kv_tensor {
+    ggml_type type = GGML_TYPE_COUNT;
+    int64_t ne[4] = {};
+    uint64_t nb[4] = {};
+    uint64_t data = 0;
+    uint64_t bytes = 0;
+};
+
+struct ggml_cuda_q4_kv_policy {
+    bool enabled = false;
+    int cc = 0;
+    ggml_cuda_q4_kv_tensor q, k, v, mask;
+    bool mask_present = false;
+    bool has_sinks = false;
+    bool use_sparse = false;
+    bool shared_kv = false;
+    float max_bias = 0.0f;
+    float logit_softcap = 0.0f;
+};
+
+// Private diagnostic ABI. No CUDA or context pointer crosses this interface.
+struct ggml_cuda_fattn_q4_kv_stats {
+    uint64_t eligible_calls = 0;
+    uint64_t fused_calls = 0;
+    uint64_t occupancy_fallbacks = 0;
+    uint64_t baseline_blocks_per_sm = 0;
+    uint64_t candidate_blocks_per_sm = 0;
+    uint64_t grid_x = 0, grid_y = 0, grid_z = 0;
+    uint64_t block_x = 0, block_y = 0, block_z = 0;
+    uint64_t shared_bytes = 0;
+    uint64_t kv_rows = 0, query_rows = 0;
+    uint64_t tile_rows = 0, output_tiles = 0;
+    uint64_t stream_k = 0;
+};
+
+constexpr bool ggml_cuda_q4_kv_enabled(const char * value) {
+    return value == nullptr || (value[0] == '1' && value[1] == '\0');
+}
+
+// Automatic activation has no diagnostics. Explicit 0/1 modes provide paired
+// stock/fused launch proof; malformed values disable the optimization silently.
+constexpr bool ggml_cuda_q4_kv_diagnostics(const char * value) {
+    return value != nullptr && (value[0] == '0' || value[0] == '1') && value[1] == '\0';
+}
+
+namespace ggml_cuda_q4_kv_detail {
+
+constexpr bool multiply(uint64_t a, uint64_t b, uint64_t & result) {
+    if (b != 0 && a > std::numeric_limits<uint64_t>::max() / b) return false;
+    result = a * b;
+    return true;
+}
+
+constexpr bool add(uint64_t a, uint64_t b, uint64_t & result) {
+    if (a > std::numeric_limits<uint64_t>::max() - b) return false;
+    result = a + b;
+    return true;
+}
+
+constexpr bool tensor_span(const ggml_cuda_q4_kv_tensor & t,
+        uint64_t block_elements, uint64_t block_bytes, uint64_t & span) {
+    for (int i = 0; i < 4; ++i) {
+        if (t.ne[i] <= 0 || t.ne[i] > std::numeric_limits<int32_t>::max() || t.nb[i] == 0) return false;
+    }
+    if (t.ne[0] % block_elements != 0 || t.nb[0] != block_bytes) return false;
+    if (!multiply(uint64_t(t.ne[0]) / block_elements, block_bytes, span)) return false;
+    for (int i = 1; i < 4; ++i) {
+        uint64_t term = 0;
+        if (!multiply(uint64_t(t.ne[i] - 1), t.nb[i], term) || !add(span, term, span)) return false;
+    }
+    return t.data != 0 && t.data % 16 == 0 && t.bytes >= span &&
+        t.data <= std::numeric_limits<uint64_t>::max() - span;
+}
+
+// Recognize both the production head-interleaved FA view and a head-major test
+// tensor. Single-sequence views may retain the full allocated cache's nb[3].
+constexpr bool dense_rows_heads(const ggml_cuda_q4_kv_tensor & t,
+        uint64_t row_bytes, uint64_t span) {
+    uint64_t rows_bytes = 0, heads_bytes = 0;
+    if (!multiply(row_bytes, uint64_t(t.ne[1]), rows_bytes) ||
+        !multiply(row_bytes, uint64_t(t.ne[2]), heads_bytes)) return false;
+    const bool head_major = t.nb[1] == row_bytes && t.nb[2] == rows_bytes;
+    const bool token_major = t.nb[1] == heads_bytes && t.nb[2] == row_bytes;
+    return (head_major || token_major) && t.nb[3] >= span && t.nb[3] % 4 == 0 &&
+        t.nb[1] <= std::numeric_limits<int32_t>::max() &&
+        t.nb[2] <= std::numeric_limits<int32_t>::max() &&
+        t.nb[3] <= uint64_t(std::numeric_limits<int64_t>::max());
+}
+
+constexpr bool overlaps(const ggml_cuda_q4_kv_tensor & a, uint64_t a_span,
+        const ggml_cuda_q4_kv_tensor & b, uint64_t b_span) {
+    // End-address overflow was rejected by tensor_span().
+    return a.data < b.data + b_span && b.data < a.data + a_span;
+}
+
+} // namespace ggml_cuda_q4_kv_detail
+
+constexpr bool ggml_cuda_q4_kv_eligible(const ggml_cuda_q4_kv_policy & p) {
+    using namespace ggml_cuda_q4_kv_detail;
+    if (!p.enabled || p.cc != 890 || !p.mask_present || p.has_sinks ||
+        p.use_sparse || p.shared_kv || p.max_bias != 0.0f || p.logit_softcap != 0.0f) return false;
+    if (p.q.type != GGML_TYPE_F32 || p.k.type != GGML_TYPE_Q4_0 ||
+        p.v.type != GGML_TYPE_Q4_0 || p.mask.type != GGML_TYPE_F16) return false;
+    if (p.q.ne[0] != 256 || (p.q.ne[1] != 3 && p.q.ne[1] != 4) ||
+        p.q.ne[2] != 24 || p.q.ne[3] != 1 || p.k.ne[0] != 256 ||
+        p.k.ne[1] <= 0 || p.k.ne[1] % 256 != 0 || p.k.ne[2] != 4 || p.k.ne[3] != 1) return false;
+    for (int i = 0; i < 4; ++i) if (p.k.ne[i] != p.v.ne[i]) return false;
+    for (int i = 0; i < 3; ++i) if (p.k.nb[i] != p.v.nb[i]) return false;
+    if (p.mask.ne[0] != p.k.ne[1] || p.mask.ne[1] < p.q.ne[1] ||
+        p.mask.ne[2] != 1 || p.mask.ne[3] != 1) return false;
+
+    uint64_t q_span = 0, k_span = 0, v_span = 0, mask_span = 0;
+    if (!tensor_span(p.q, 1, 4, q_span) || !tensor_span(p.k, 32, 18, k_span) ||
+        !tensor_span(p.v, 32, 18, v_span) || !tensor_span(p.mask, 1, 2, mask_span)) return false;
+    if (!dense_rows_heads(p.q, 256 * 4, q_span) || !dense_rows_heads(p.k, 8 * 18, k_span) ||
+        !dense_rows_heads(p.v, 8 * 18, v_span)) return false;
+    // Q stride arguments narrow to int32_t; the single-sequence stride still
+    // must be representable even though it is not dereferenced at sequence 0.
+    if (p.q.nb[3] > std::numeric_limits<int32_t>::max()) return false;
+    for (int i = 1; i < 4; ++i) if (p.q.nb[i] % 16 != 0 || p.mask.nb[i] % 16 != 0) return false;
+
+    uint64_t mask_row = 0, mask_plane = 0;
+    if (!multiply(uint64_t(p.mask.ne[0]), 2, mask_row) ||
+        !multiply(mask_row, uint64_t(p.mask.ne[1]), mask_plane)) return false;
+    if (p.mask.nb[1] != mask_row || p.mask.nb[2] < mask_plane || p.mask.nb[3] < mask_plane ||
+        p.mask.nb[1] > std::numeric_limits<int32_t>::max() ||
+        p.mask.nb[2] > std::numeric_limits<int32_t>::max() ||
+        p.mask.nb[3] > uint64_t(std::numeric_limits<int64_t>::max())) return false;
+
+    // These read-only inputs normally have separate tensors. Reject overlap so
+    // the first prototype does not broaden the existing shared-K/V contract.
+    return !overlaps(p.k, k_span, p.v, v_span) &&
+        !overlaps(p.q, q_span, p.k, k_span) && !overlaps(p.q, q_span, p.v, v_span) &&
+        !overlaps(p.mask, mask_span, p.k, k_span) && !overlaps(p.mask, mask_span, p.v, v_span) &&
+        !overlaps(p.mask, mask_span, p.q, q_span);
+}
