+    q4_kv_stats.grid_y.store(grid.y, std::memory_order_relaxed);
+    q4_kv_stats.grid_z.store(grid.z, std::memory_order_relaxed);
+    q4_kv_stats.block_x.store(block.x, std::memory_order_relaxed);
+    q4_kv_stats.block_y.store(block.y, std::memory_order_relaxed);
+    q4_kv_stats.block_z.store(block.z, std::memory_order_relaxed);
+    q4_kv_stats.shared_bytes.store(shared_bytes, std::memory_order_relaxed);
+    q4_kv_stats.kv_rows.store(kv_rows, std::memory_order_relaxed);
+    q4_kv_stats.query_rows.store(query_rows, std::memory_order_relaxed);
+    q4_kv_stats.tile_rows.store(tile_rows, std::memory_order_relaxed);
+    q4_kv_stats.output_tiles.store(output_tiles, std::memory_order_relaxed);
+    q4_kv_stats.stream_k.store(stream_k, std::memory_order_relaxed);
+    q4_kv_stats.baseline_blocks_per_sm.store(baseline_blocks, std::memory_order_relaxed);
