+static __device__ __forceinline__ void ggml_cuda_fattn_q4_0_decode_8(
+        const block_q4_0 * const row, const int scalar_offset, half * const output) {
+    const block_q4_0 & block = row[scalar_offset / QK4_0];
+    const int within = scalar_offset % QK4_0;
+    const float d = __half2float(block.d);
+    const float dm = -8*d;
+#pragma unroll
+    for (int l = 0; l < 8; ++l) {
+        const int channel = within + l;
+        const uint8_t packed = block.qs[channel % (QK4_0/2)];
+        const int value = channel < QK4_0/2 ? packed & 0xF : packed >> 4;
+        output[l] = ggml_cuda_cast<half>(d * value + dm);
+    }
