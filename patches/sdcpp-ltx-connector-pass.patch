+        std::optional<std::string> prepare_connector_context(int n_threads,
+                const sd::Tensor<float>& context, bool audio) {
+            if (context.empty()) return std::string{};
+            // Adapters can have mutable schedules; do not reuse their outputs.
+            if (weight_adapter) connector_inputs.clear();
+            const auto found = connector_inputs.find(context.shape(), context.values(), audio, linear_scale, attn_scale);
+            auto key_for = [](size_t slot) { return "ltxav.connector." + std::to_string(slot); };
+            if (found) {
+                const auto key = key_for(*found);
+                if (get_cache_tensor_by_name(key + ".video") && (!audio || get_cache_tensor_by_name(key + ".audio")))
+                    return key;
+            }
+            const auto key = key_for(connector_inputs.replacement_slot());
+            std::vector<ggml_tensor*> connector_params;
+            auto graph = [&]() {
+                auto* input = make_input(context);
+                const auto rope = build_connector_rope(input, audio);
+                auto runner_ctx = get_context();
+                const auto outputs = model.preprocess_contexts(&runner_ctx, input, rope.first, rope.second, audio);
+                if (!outputs.first || (audio && !outputs.second)) return static_cast<ggml_cgraph*>(nullptr);
+                auto* gf = new_graph_custom(LTXAV_GRAPH_SIZE);
+                auto* video = ggml_cont(compute_ctx, outputs.first);
+                cache(key + ".video", video);
+                ggml_build_forward_expand(gf, video);
+                if (audio) {
+                    auto* audio_output = ggml_cont(compute_ctx, outputs.second);
+                    cache(key + ".audio", audio_output);
+                    ggml_build_forward_expand(gf, audio_output);
+                }
+                connector_params = collect_used_param_tensors(gf);
+                return gf;
+            };
+            const auto result = GGMLRunner::compute(graph, n_threads, false, true);
+            // The source offloads connectors before activating the transformer.
+            const bool released = workspace_.release();
+            evict_compute_backend_param_tensors(connector_params);
+            sync_runtime_residency();
+            if (!result.has_value() || !released) {
+                connector_inputs.clear();
+                free_cache_ctx_and_buffer();
+                LOG_ERROR("LTX connector preparation failed");
+                return std::nullopt;
+            }
+            connector_inputs.commit(context.shape(), context.values(), audio, linear_scale, attn_scale, !weight_adapter);
+            LOG_INFO("LTX connectors prepared: %s (audio %s)", key.c_str(), audio ? "on" : "off");
+            return key;
+        }
