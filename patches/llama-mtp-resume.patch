new file mode 100644
index 000000000..bba759a51
--- /dev/null
+++ b/common/speculative-mtp-state.h
@@ -0,0 +1,245 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <new>
+#include <vector>
+
+// The hidden predecessor belongs to a NEXT-input boundary, not merely the
+// last invocation of process(). M-RoPE image patches can repeat pos[0], so
+// embedded continuations stay unsealed until the caller supplies the real
+// position immediately after the whole image/audio chunk.
+struct common_mtp_state {
+    struct row_view { int32_t next; const float * data; };
+    struct row { int32_t next; std::vector<float> data; };
+
+    const size_t width;
+    const size_t history_limit;
+    const size_t verify_limit;
+    std::vector<float> pending;
+    int32_t pending_next = 0;
+    bool sealed = true;
+    bool embedded = false;
+    std::vector<row> history;
+    std::vector<float> verify;
+    std::vector<int32_t> verify_next;
+    uint32_t verify_total = 0;
+
+    common_mtp_state(size_t width, size_t history_limit, size_t verify_limit)
+        : width(width), history_limit(std::max<size_t>(2, std::min<size_t>(256, history_limit))),
+          verify_limit(std::max<size_t>(1, verify_limit)), pending(width, 0.0f) {}
+
+    void clear_verify() { verify.clear(); verify_next.clear(); verify_total = 0; }
+    void reset() {
+        std::fill(pending.begin(), pending.end(), 0.0f);
+        pending_next = 0; sealed = true; embedded = false;
+        history.clear(); clear_verify();
+    }
+    void invalidate() {
+        reset(); pending_next = -1; sealed = false;
+    }
+    const float * find(int32_t next) const {
+        if (next < 0) return nullptr;
+        if (sealed && pending_next == next) return pending.data();
+        const auto it = std::lower_bound(history.begin(), history.end(), next,
+                [](const row & value, int32_t key) { return value.next < key; });
+        return it != history.end() && it->next == next ? it->data.data() : nullptr;
+    }
+    const float * predecessor(int32_t next, bool is_embedded) const {
+        if (is_embedded && embedded) return pending.data();
+        return find(next);
+    }
+    const float * prepare(int32_t next, bool is_embedded) {
+        if (next == 0 && !(is_embedded && embedded)) reset();
+        // This binding is allowed only during uninterrupted processing. load()
+        // never restores embedded=true, and request preflight rewinds first.
+        if (!is_embedded && embedded) seal(next);
+        return predecessor(next, is_embedded);
+    }
+    bool rewind(int32_t next) {
+        if (next == 0) { reset(); return true; }
+        const float * source = find(next);
+        if (!source) return false;
+        if (source != pending.data()) std::memcpy(pending.data(), source, width * sizeof(float));
+        history.erase(std::remove_if(history.begin(), history.end(),
+                [next](const row & value) { return value.next > next; }), history.end());
+        pending_next = next; sealed = true; embedded = false; clear_verify();
+        return true;
+    }
+    void put(int32_t next, const float * data) {
+        if (next <= 0) return;
+        auto it = std::lower_bound(history.begin(), history.end(), next,
+                [](const row & value, int32_t key) { return value.next < key; });
+        if (it == history.end() || it->next != next) it = history.insert(it, {next, {}});
+        it->data.resize(width);
+        std::memcpy(it->data.data(), data, width * sizeof(float));
+        while (history.size() > history_limit) history.erase(history.begin());
+    }
+
+    // reader(i) is the ACTUAL target row used by process(). Only the rows that
+    // accept() can select and a small rewind tail need a host-side copy. A
+    // 4096-row prompt must not copy its entire hidden matrix into verify scratch.
+    template<class Reader>
+    void record(int32_t first, size_t count, Reader reader) {
+        if (count == 0) { clear_verify(); return; }
+        history.erase(std::remove_if(history.begin(), history.end(),
+                [first](const row & value) { return value.next > first; }), history.end());
+        const size_t keep = std::min(count, verify_limit);
+        verify.resize(keep * width); verify_next.resize(keep); verify_total = uint32_t(count);
+        for (size_t i = 0; i < keep; ++i) {
+            const auto value = reader(i);
+            verify_next[i] = value.next;
+            std::memcpy(verify.data() + i * width, value.data, width * sizeof(float));
+        }
+        const size_t tail = count > history_limit ? count - history_limit : 0;
+        for (size_t i = tail; i < count; ++i) {
+            const auto value = reader(i);
+            put(value.next, value.data);
+        }
+        const auto last = reader(count - 1);
+        std::memcpy(pending.data(), last.data, width * sizeof(float));
+        pending_next = last.next;
+        sealed = last.next >= 0;
+        embedded = !sealed;
+    }
+    bool accept(uint32_t n) {
+        if (verify_total == 0) return true;
+        const size_t index = std::min<uint32_t>(n, verify_total - 1);
+        if (index >= verify_next.size()) { invalidate(); return false; }
+        const int32_t next = verify_next[index];
+        if (next <= 0) { invalidate(); return false; }
+        std::memcpy(pending.data(), verify.data() + index * width, width * sizeof(float));
+        pending_next = next; sealed = true; embedded = false;
+        history.erase(std::remove_if(history.begin(), history.end(),
+                [next](const row & value) { return value.next > next; }), history.end());
+        put(next, pending.data());
+        return true;
+    }
+    void seal(int32_t next) {
+        if (next < 0) { invalidate(); return; }
+        if (next == 0) { reset(); return; }
+        pending_next = next; sealed = true; embedded = false;
+        put(next, pending.data());
+    }
+    void erase(int32_t first, int32_t end) {
+        const auto removed = [first, end](int32_t next) {
+            return next > first && (end < 0 || next <= end);
+        };
+        history.erase(std::remove_if(history.begin(), history.end(),
+                [&](const row & value) { return removed(value.next); }), history.end());
+        if (sealed && removed(pending_next)) { pending_next = -1; sealed = false; }
+        embedded = false; clear_verify();
+    }
+    void shift(int32_t first, int32_t end, int32_t delta) {
+        const auto moved = [first, end](int32_t next) { return next > first && (end < 0 || next <= end); };
+        const auto shifted = [delta](int32_t value) { return int64_t(value) + delta; };
+        for (const auto & value : history) if (moved(value.next) &&
+                (shifted(value.next) < 0 || shifted(value.next) > INT32_MAX)) { invalidate(); return; }
+        if (sealed && moved(pending_next) && (shifted(pending_next) < 0 || shifted(pending_next) > INT32_MAX)) { invalidate(); return; }
+        for (auto & value : history) if (moved(value.next)) value.next = int32_t(shifted(value.next));
+        if (sealed && moved(pending_next)) pending_next = int32_t(shifted(pending_next));
+        history.erase(std::remove_if(history.begin(), history.end(),
+                [](const row & value) { return value.next <= 0; }), history.end());
+        std::stable_sort(history.begin(), history.end(), [](const row & a, const row & b) { return a.next < b.next; });
+        // Context shifting can place a kept prefix and moved tail at the same
+        // boundary. The moved tail is later in stream order and owns that row.
+        for (size_t i = 1; i < history.size();) {
+            if (history[i - 1].next == history[i].next) history.erase(history.begin() + i - 1);
+            else ++i;
+        }
+        embedded = false; clear_verify();
+    }
+
+    static void u32(std::vector<uint8_t> & out, uint32_t value) {
+        for (int i = 0; i < 4; ++i) out.push_back(uint8_t(value >> (8 * i)));
+    }
+    static bool u32(const std::vector<uint8_t> & in, size_t & cursor, uint32_t & value) {
+        if (in.size() - cursor < 4) return false;
+        value = 0;
+        for (int i = 0; i < 4; ++i) value |= uint32_t(in[cursor++]) << (8 * i);
+        return true;
+    }
+    void save(std::vector<uint8_t> & out) const {
+        out.clear();
+        out.reserve(32 + width * sizeof(float) +
+                (history.size() + verify_next.size()) * (4 + width * sizeof(float)));
+        u32(out, 0x5350544d); // MTPS
+        u32(out, 1); u32(out, uint32_t(width));
+        u32(out, sealed ? 1 : 0); u32(out, uint32_t(pending_next));
+        u32(out, uint32_t(history.size())); u32(out, uint32_t(verify_next.size())); u32(out, verify_total);
+        const auto floats = [&](const float * values, size_t count) {
+            const auto * bytes = reinterpret_cast<const uint8_t *>(values);
+            out.insert(out.end(), bytes, bytes + count * sizeof(float));
+        };
+        floats(pending.data(), width);
+        for (const auto & value : history) { u32(out, uint32_t(value.next)); floats(value.data.data(), width); }
+        for (size_t i = 0; i < verify_next.size(); ++i) {
+            u32(out, uint32_t(verify_next[i])); floats(verify.data() + i * width, width);
+        }
+    }
+    bool restore(const std::vector<uint8_t> & in) {
+        try {
+            if (load(in)) return true;
+        } catch (const std::bad_alloc &) {
+            // The GPU payload may already have changed conversations. Do not
+            // leave the old predecessor eligible when parsing cannot allocate.
+        }
+        invalidate();
+        return false;
+    }
+    // Parse transactionally; the public restore wrapper invalidates on failure
+    // because the GPU states may already have switched to another conversation.
+    bool load(const std::vector<uint8_t> & in) {
+        static_assert(sizeof(float) == 4, "MTP state requires 32-bit float rows");
+        size_t cursor = 0;
+        uint32_t magic, version, saved_width, flags, next, n_history, n_verify, total;
+        if (!u32(in,cursor,magic) || !u32(in,cursor,version) || !u32(in,cursor,saved_width) ||
+            !u32(in,cursor,flags) || !u32(in,cursor,next) || !u32(in,cursor,n_history) ||
+            !u32(in,cursor,n_verify) || !u32(in,cursor,total)) return false;
+        if (magic != 0x5350544d || version != 1 || saved_width != width || flags > 1 ||
+            n_history > history_limit || n_verify > verify_limit || n_verify > total ||
+            (total != 0 && n_verify != std::min<size_t>(total, verify_limit)) ||
+            (flags && next > uint32_t(INT32_MAX)) || (!flags && next != UINT32_MAX)) return false;
+        if (width > (std::numeric_limits<size_t>::max() - 32) / sizeof(float)) return false;
+        const size_t row_bytes = width * sizeof(float);
+        const size_t records = size_t(n_history) + n_verify;
+        if (records > (std::numeric_limits<size_t>::max() - 32 - row_bytes) / (4 + row_bytes) ||
+            in.size() != 32 + row_bytes + records * (4 + row_bytes)) return false;
+        common_mtp_state parsed(width, history_limit, verify_limit);
+        parsed.pending_next = int32_t(next); parsed.sealed = flags != 0; parsed.embedded = false;
+        std::memcpy(parsed.pending.data(), in.data() + cursor, row_bytes); cursor += row_bytes;
+        int32_t previous = 0;
+        for (size_t i = 0; i < n_history; ++i) {
+            uint32_t boundary;
+            if (!u32(in,cursor,boundary) || boundary > uint32_t(INT32_MAX) || int32_t(boundary) <= previous) return false;
+            previous = int32_t(boundary);
+            if (parsed.sealed && previous > parsed.pending_next) return false;
+            parsed.history.push_back({previous, std::vector<float>(width)});
+            std::memcpy(parsed.history.back().data.data(), in.data() + cursor, row_bytes); cursor += row_bytes;
+        }
+        parsed.verify.resize(size_t(n_verify) * width); parsed.verify_next.resize(n_verify); parsed.verify_total = total;
+        for (size_t i = 0; i < n_verify; ++i) {
+            uint32_t boundary;
+            if (!u32(in,cursor,boundary) || (boundary > uint32_t(INT32_MAX) && boundary != UINT32_MAX)) return false;
+            parsed.verify_next[i] = int32_t(boundary);
+            std::memcpy(parsed.verify.data() + i * width, in.data() + cursor, row_bytes); cursor += row_bytes;
+        }
+        if (parsed.sealed) {
+            if (parsed.pending_next == 0) {
+                const std::vector<float> zeros(width, 0.0f);
+                if (!parsed.history.empty() || parsed.verify_total != 0 ||
+                    std::memcmp(parsed.pending.data(), zeros.data(), row_bytes) != 0) return false;
+            } else {
+                const auto it = std::lower_bound(parsed.history.begin(), parsed.history.end(), parsed.pending_next,
+                        [](const row & value, int32_t key) { return value.next < key; });
+                if (it == parsed.history.end() || it->next != parsed.pending_next ||
+                    std::memcmp(it->data.data(), parsed.pending.data(), row_bytes) != 0) return false;
+            }
+        }
+        pending.swap(parsed.pending); history.swap(parsed.history); verify.swap(parsed.verify); verify_next.swap(parsed.verify_next);
+        pending_next = parsed.pending_next; sealed = parsed.sealed; embedded = false; verify_total = parsed.verify_total;
+        return true;
+    }
+};
