diff --git a/common/state-storage.h b/common/state-storage.h
new file mode 100644
index 000000000..91cb5cb5c
--- /dev/null
+++ b/common/state-storage.h
@@ -0,0 +1,78 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <initializer_list>
+#include <memory>
+#include <vector>
+
+inline bool common_state_storage_enabled() {
+    const char * value = std::getenv("EZLOCALAI_LLAMA_CACHE_STORAGE");
+    return value == nullptr || std::strcmp(value, "0") != 0;
+}
+
+// Checkpoint bytes are immutable until a writer requests its own copy.
+class common_state_blob {
+public:
+    common_state_blob() = default;
+    common_state_blob(std::initializer_list<uint8_t> bytes) { *this = bytes; }
+    common_state_blob(const common_state_blob & other) : storage(other.storage) {
+        if (storage && !common_state_storage_enabled()) storage = std::make_shared<std::vector<uint8_t>>(*storage);
+    }
+    common_state_blob(common_state_blob &&) noexcept = default;
+    common_state_blob & operator=(common_state_blob &&) noexcept = default;
+    common_state_blob & operator=(const common_state_blob & other) {
+        common_state_blob copy(other);
+        storage.swap(copy.storage);
+        return *this;
+    }
+
+    common_state_blob & operator=(std::initializer_list<uint8_t> bytes) {
+        if (bytes.size() == 0) {
+            clear();
+        } else {
+            storage = std::make_shared<std::vector<uint8_t>>(bytes);
+        }
+        return *this;
+    }
+
+    size_t size() const noexcept { return storage ? storage->size() : 0; }
+    size_t capacity() const noexcept { return storage ? storage->capacity() : 0; }
+    bool empty() const noexcept { return size() == 0; }
+
+    const uint8_t * data() const noexcept { return storage ? storage->data() : nullptr; }
+    uint8_t * data() {
+        if (!storage) return nullptr;
+        make_writable();
+        return storage->data();
+    }
+
+    void resize(size_t count) {
+        if (count == 0) {
+            clear();
+            return;
+        }
+        make_writable();
+        storage->resize(count);
+    }
+
+    void clear() noexcept { storage.reset(); }
+
+    friend bool operator==(const common_state_blob & a, const common_state_blob & b) {
+        return a.storage == b.storage || (a.size() == b.size() &&
+                (a.empty() || *a.storage == *b.storage));
+    }
+    friend bool operator!=(const common_state_blob & a, const common_state_blob & b) { return !(a == b); }
+
+private:
+    std::shared_ptr<std::vector<uint8_t>> storage;
+
+    void make_writable() {
+        if (!storage) {
+            storage = std::make_shared<std::vector<uint8_t>>();
+        } else if (!storage.unique()) {
+            storage = std::make_shared<std::vector<uint8_t>>(*storage);
+        }
+    }
+};
