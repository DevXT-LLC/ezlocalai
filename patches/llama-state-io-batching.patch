diff --git a/src/llama-state-io.h b/src/llama-state-io.h
new file mode 100644
--- /dev/null
+++ b/src/llama-state-io.h
@@ -0,0 +1,216 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+#include <vector>
+
+// This is working memory for state IO, not storage for cached states. A
+// context owns at most 64 MiB of pinned memory per CUDA backend; its snapshots
+// remain ordinary pageable vectors and can still be swapped by the OS.
+class llama_state_io_pool {
+public:
+    static constexpr size_t max_capacity = 64u * 1024u * 1024u;
+    explicit llama_state_io_pool(size_t capacity = max_capacity) : capacity_(std::min(capacity, max_capacity)) {}
+    ~llama_state_io_pool() { clear(); }
+    llama_state_io_pool(const llama_state_io_pool &) = delete;
+    llama_state_io_pool & operator=(const llama_state_io_pool &) = delete;
+
+    struct workspace { uint8_t * data = nullptr; size_t capacity = 0; };
+
+    workspace acquire(ggml_backend_t backend) noexcept {
+        if (capacity_ == 0) return {};
+        ggml_backend_buffer_t allocated = nullptr;
+        try {
+            entry * item = nullptr;
+            for (auto & value : entries) {
+                if (value.backend == backend) { item = &value; break; }
+            }
+            if (item == nullptr) {
+                entries.push_back({backend, nullptr, false});
+                item = &entries.back();
+            }
+            if (!item->attempted) {
+                item->attempted = true;
+                const auto host_type = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+                if (host_type == nullptr || !ggml_backend_buft_is_host(host_type)) return {};
+                allocated = ggml_backend_buft_alloc_buffer(host_type, capacity_);
+                // CUDA's host allocator can silently fall back to pageable CPU
+                // storage. That is not pinned staging; retain legacy IO instead.
+                if (allocated == nullptr) return {};
+                if (ggml_backend_buffer_get_type(allocated) != host_type ||
+                        ggml_backend_buffer_get_size(allocated) > capacity_ ||
+                        ggml_backend_buffer_get_size(allocated) == 0 ||
+                        ggml_backend_buffer_get_base(allocated) == nullptr) {
+                    ggml_backend_buffer_free(allocated);
+                    return {};
+                }
+                item->buffer = allocated;
+                allocated = nullptr;
+            }
+            if (item->buffer == nullptr) return {};
+            return {static_cast<uint8_t *>(ggml_backend_buffer_get_base(item->buffer)),
+                    ggml_backend_buffer_get_size(item->buffer)};
+        } catch (const std::bad_alloc &) {
+            if (allocated != nullptr) ggml_backend_buffer_free(allocated);
+            return {};
+        }
+    }
+
+    size_t capacity() const { return capacity_; }
+    void clear() {
+        for (auto & item : entries) ggml_backend_buffer_free(item.buffer);
+        entries.clear();
+    }
+
+private:
+    struct entry { ggml_backend_t backend; ggml_backend_buffer_t buffer; bool attempted; };
+    size_t capacity_;
+    std::vector<entry> entries;
+};
+
+// Preserve host snapshot bytes and transfer order. CUDA chunks go through a
+// bounded pinned window; downloads are copied into the caller's pageable
+// destination only after synchronization. Upload source bytes are copied into
+// stable staging before queueing. Non-CUDA/special buffers and allocation
+// failures use the original synchronous accessors.
+class llama_state_io_batch {
+public:
+    explicit llama_state_io_batch(ggml_backend_sched_t sched, llama_state_io_pool * pool = nullptr) : pool(pool) {
+        const char * setting = std::getenv("EZLOCALAI_LLAMA_STATE_IO_BATCHING");
+        if (sched == nullptr || pool == nullptr || (setting != nullptr && std::strcmp(setting, "0") == 0)) return;
+        try {
+            const int count = ggml_backend_sched_get_n_backends(sched);
+            targets.reserve(count);
+            for (int i = 0; i < count; ++i) {
+                const auto backend = ggml_backend_sched_get_backend(sched, i);
+                const auto device = ggml_backend_get_device(backend);
+                const auto registry = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+                if (registry == nullptr || std::strcmp(ggml_backend_reg_name(registry), "CUDA") != 0) continue;
+                const auto type = ggml_backend_get_default_buffer_type(backend);
+                if (type != nullptr && !ggml_backend_buft_is_host(type)) targets.push_back({type, backend});
+            }
+        } catch (const std::bad_alloc &) {
+            targets.clear();
+        }
+    }
+
+    ~llama_state_io_batch() { finish(); }
+    llama_state_io_batch(const llama_state_io_batch &) = delete;
+    llama_state_io_batch & operator=(const llama_state_io_batch &) = delete;
+
+    void get(const ggml_tensor * tensor, void * data, size_t offset, size_t size) {
+        if (size == 0) return;
+        auto * target = find(tensor);
+        if (target == nullptr || !acquire(*target)) {
+            finish();
+            ggml_backend_tensor_get(tensor, data, offset, size);
+            return;
+        }
+        begin(direction::download);
+        size_t copied = 0;
+        while (copied < size) {
+            const auto * device = static_cast<const uint8_t *>(tensor->data) + offset + copied;
+            // A previous download can write imported/unified host memory
+            // which the next transfer is about to read as a device tensor.
+            for (size_t i = 0; i < n_records; ++i) {
+                if (overlap(records[i].host, records[i].size, device, size - copied)) { finish(); break; }
+            }
+            room(*target);
+            const size_t count = std::min(size - copied, target->capacity - target->filled);
+            ggml_backend_tensor_get_async(target->backend, tensor, target->data + target->filled, offset + copied, count);
+            records[n_records++] = {target, static_cast<uint8_t *>(data) + copied, device, target->filled, count};
+            target->filled += count; target->used = true;
+            active = direction::download;
+            copied += count;
+        }
+    }
+
+    void set(ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+        if (size == 0) return;
+        auto * target = find(tensor);
+        if (target == nullptr || !acquire(*target)) {
+            finish();
+            ggml_backend_tensor_set(tensor, data, offset, size);
+            return;
+        }
+        begin(direction::upload);
+        size_t copied = 0;
+        while (copied < size) {
+            const auto * source = static_cast<const uint8_t *>(data) + copied;
+            const auto * device = static_cast<const uint8_t *>(tensor->data) + offset + copied;
+            // Preserve read-after-write aliasing and writes shared by multiple
+            // device streams before copying more host input into staging.
+            for (size_t i = 0; i < n_records; ++i) {
+                if (overlap(source, size - copied, records[i].device, records[i].size) ||
+                        (records[i].owner != target && overlap(device, size - copied, records[i].device, records[i].size))) {
+                    finish(); break;
+                }
+            }
+            room(*target);
+            const size_t count = std::min(size - copied, target->capacity - target->filled);
+            std::memcpy(target->data + target->filled, source, count);
+            ggml_backend_tensor_set_async(target->backend, tensor, target->data + target->filled, offset + copied, count);
+            records[n_records++] = {target, nullptr, device, target->filled, count};
+            target->filled += count; target->used = true;
+            active = direction::upload;
+            copied += count;
+        }
+    }
+
+    void finish() {
+        for (auto & target : targets) if (target.used) ggml_backend_synchronize(target.backend);
+        if (active == direction::download) {
+            // Apply readbacks in serialization order even across CUDA devices.
+            for (size_t i = 0; i < n_records; ++i) {
+                const auto & copy = records[i];
+                std::memcpy(copy.host, copy.owner->data + copy.offset, copy.size);
+            }
+        }
+        for (auto & target : targets) { target.used = false; target.filled = 0; }
+        n_records = 0; active = direction::none;
+    }
+
+private:
+    enum class direction { none, download, upload };
+    struct target {
+        ggml_backend_buffer_type_t type;
+        ggml_backend_t backend;
+        uint8_t * data = nullptr;
+        size_t capacity = 0, filled = 0;
+        bool used = false, attempted = false;
+    };
+    struct record { target * owner; uint8_t * host; const uint8_t * device; size_t offset, size; };
+    llama_state_io_pool * pool;
+    std::vector<target> targets;
+    std::array<record, 256> records{};
+    size_t n_records = 0;
+    direction active = direction::none;
+
+    static bool overlap(const void * a, size_t a_size, const void * b, size_t b_size) {
+        const auto first = reinterpret_cast<uintptr_t>(a), second = reinterpret_cast<uintptr_t>(b);
+        return a_size != 0 && b_size != 0 && (first <= second ? second - first < a_size : first - second < b_size);
+    }
+    void begin(direction next) { if (active != direction::none && active != next) finish(); }
+    void room(target & value) { if (value.filled == value.capacity || n_records == records.size()) finish(); }
+    bool acquire(target & value) {
+        if (!value.attempted) {
+            value.attempted = true;
+            const auto workspace = pool->acquire(value.backend);
+            value.data = workspace.data; value.capacity = workspace.capacity;
+        }
+        return value.data != nullptr && value.capacity != 0;
+    }
+    target * find(const ggml_tensor * tensor) {
+        const auto buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+        if (buffer == nullptr) return nullptr;
+        const auto type = ggml_backend_buffer_get_type(buffer);
+        for (auto & target : targets) if (target.type == type) return &target;
+        return nullptr;
+    }
+};
