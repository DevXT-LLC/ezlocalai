diff --git a/src/llama-state-io.h b/src/llama-state-io.h
new file mode 100644
--- /dev/null
+++ b/src/llama-state-io.h
@@ -0,0 +1,91 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+// Host sequence snapshots retain their byte layout. Queue ordinary CUDA
+// buffer transfers in serialization order and finish them before returning
+// the caller's host buffer. Other buffer/backend implementations keep their
+// existing synchronous accessors (notably CUDA split and host buffers).
+class llama_state_io_batch {
+public:
+    explicit llama_state_io_batch(ggml_backend_sched_t sched) {
+        const char * setting = std::getenv("EZLOCALAI_LLAMA_STATE_IO_BATCHING");
+        if (sched == nullptr || (setting != nullptr && std::strcmp(setting, "0") == 0)) {
+            return;
+        }
+        const int count = ggml_backend_sched_get_n_backends(sched);
+        targets.reserve(count);
+        for (int i = 0; i < count; ++i) {
+            ggml_backend_t backend = ggml_backend_sched_get_backend(sched, i);
+            ggml_backend_dev_t device = ggml_backend_get_device(backend);
+            ggml_backend_reg_t registry = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+            if (registry == nullptr || std::strcmp(ggml_backend_reg_name(registry), "CUDA") != 0) {
+                continue;
+            }
+            ggml_backend_buffer_type_t type = ggml_backend_get_default_buffer_type(backend);
+            if (type != nullptr && !ggml_backend_buft_is_host(type)) {
+                targets.push_back({type, backend, false});
+            }
+        }
+    }
+
+    ~llama_state_io_batch() { finish(); }
+
+    llama_state_io_batch(const llama_state_io_batch &) = delete;
+    llama_state_io_batch & operator=(const llama_state_io_batch &) = delete;
+
+    void get(const ggml_tensor * tensor, void * data, size_t offset, size_t size) {
+        if (size == 0) return;
+        if (auto * target = find(tensor)) {
+            target->used = true;
+            ggml_backend_tensor_get_async(target->backend, tensor, data, offset, size);
+        } else {
+            // Preserve ordering with special/host buffers that may alias a
+            // prior device range (for example imported unified memory).
+            finish();
+            ggml_backend_tensor_get(tensor, data, offset, size);
+        }
+    }
+
+    void set(ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+        if (size == 0) return;
+        if (auto * target = find(tensor)) {
+            target->used = true;
+            ggml_backend_tensor_set_async(target->backend, tensor, data, offset, size);
+        } else {
+            finish();
+            ggml_backend_tensor_set(tensor, data, offset, size);
+        }
+    }
+
+    void finish() {
+        for (auto & target : targets) {
+            if (target.used) {
+                ggml_backend_synchronize(target.backend);
+                target.used = false;
+            }
+        }
+    }
+
+private:
+    struct target {
+        ggml_backend_buffer_type_t type;
+        ggml_backend_t backend;
+        bool used;
+    };
+    std::vector<target> targets;
+
+    target * find(const ggml_tensor * tensor) {
+        const auto buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+        if (buffer == nullptr) return nullptr;
+        const auto type = ggml_backend_buffer_get_type(buffer);
+        for (auto & target : targets) {
+            if (target.type == type) return &target;
+        }
+        return nullptr;
+    }
+};
