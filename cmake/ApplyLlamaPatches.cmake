cmake_minimum_required(VERSION 3.19)
if(NOT SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(metadata "${BUILD_DIR}/ezlocalai-llama-cpp-patches.txt")
# Custom engine revisions retain their own behavior. The patch is qualified
# against this exact upstream pin, independently of the chosen platform.
if(NOT revision STREQUAL "620d2225cc436ab0b001e3200e590e3b286ef9ab")
    if(BUILD_DIR)
        file(REMOVE "${metadata}")
    endif()
    message(STATUS "Custom llama.cpp revision: conversation-cache patch not applied")
    return()
endif()
if(NOT PATCH_FILE)
    set(PATCH_FILE "${CMAKE_CURRENT_LIST_DIR}/llama-conversation-cache.patch")
    if(NOT EXISTS "${PATCH_FILE}")
        set(PATCH_FILE "${CMAKE_CURRENT_LIST_DIR}/../patches/llama-conversation-cache.patch")
    endif()
endif()
if(NOT EXISTS "${PATCH_FILE}")
    message(FATAL_ERROR "Missing managed llama.cpp conversation-cache patch: ${PATCH_FILE}")
endif()
execute_process(COMMAND git -C "${SOURCE_DIR}" apply --reverse --check "${PATCH_FILE}"
    RESULT_VARIABLE already_applied OUTPUT_QUIET ERROR_QUIET)
if(REMOVE_MANAGED_PATCH)
    if(already_applied EQUAL 0)
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply --reverse "${PATCH_FILE}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply --check "${PATCH_FILE}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    if(BUILD_DIR)
        file(REMOVE "${metadata}")
    endif()
    return()
endif()
if(NOT already_applied EQUAL 0)
    execute_process(COMMAND git -C "${SOURCE_DIR}" apply --check "${PATCH_FILE}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND git -C "${SOURCE_DIR}" apply "${PATCH_FILE}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(SHA256 "${PATCH_FILE}" patch_sha256)
if(BUILD_DIR)
    file(MAKE_DIRECTORY "${BUILD_DIR}")
    file(WRITE "${metadata}" "patch.llama-conversation-cache=${patch_sha256}\n")
endif()
message(STATUS "Managed conversation-cache patch: ${patch_sha256}")
