cmake_minimum_required(VERSION 3.19)
if(NOT SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(metadata "${BUILD_DIR}/ezlocalai-llama-cpp-patches.txt")
# Custom revisions retain their own behavior; this stack is qualified at the pin.
if(NOT revision STREQUAL "620d2225cc436ab0b001e3200e590e3b286ef9ab")
    if(BUILD_DIR)
        file(REMOVE "${metadata}")
    endif()
    message(STATUS "Custom llama.cpp revision: managed patches not applied")
    return()
endif()
if(NOT PATCH_FILES)
    if(PATCH_FILE)
        # Preserve the original build-tool entrypoint and discover its stack.
        get_filename_component(patch_dir "${PATCH_FILE}" DIRECTORY)
    else()
        set(patch_dir "${CMAKE_CURRENT_LIST_DIR}")
        if(NOT EXISTS "${patch_dir}/llama-conversation-cache.patch")
            set(patch_dir "${CMAKE_CURRENT_LIST_DIR}/../patches")
        endif()
        set(PATCH_FILE "${patch_dir}/llama-conversation-cache.patch")
    endif()
    set(PATCH_FILES "${PATCH_FILE}" "${patch_dir}/llama-cache-restore-atomic.patch"
        "${patch_dir}/llama-cache-storage.patch" "${patch_dir}/llama-mtp-resume.patch"
        "${patch_dir}/llama-checkpoint-coverage.patch" "${patch_dir}/llama-checkpoint-entry-window.patch"
        "${patch_dir}/llama-cache-retention.patch" "${patch_dir}/llama-cuda-q4-kv-fusion.patch")
endif()
set(reverse_patches "${PATCH_FILES}")
list(REVERSE reverse_patches)
set(patch_metadata "")
set(affected_paths "")
foreach(patch IN LISTS PATCH_FILES)
    if(NOT EXISTS "${patch}")
        message(FATAL_ERROR "Missing managed llama.cpp patch: ${patch}")
    endif()
    file(SHA256 "${patch}" patch_sha256)
    get_filename_component(patch_name "${patch}" NAME_WE)
    string(APPEND patch_metadata "patch.${patch_name}=${patch_sha256}\n")
    file(STRINGS "${patch}" headers REGEX "^(--- a/|\\+\\+\\+ b/)")
    foreach(header IN LISTS headers)
        string(REGEX REPLACE "^(--- a/|\\+\\+\\+ b/)([^\t]+).*" "\\2" relative "${header}")
        if(relative MATCHES "(^/|(^|/)\\.\\.(/|$))")
            message(FATAL_ERROR "Invalid managed patch path: ${relative}")
        endif()
        list(APPEND affected_paths "${relative}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES affected_paths)

# Later patches can overlap earlier context. Check by peeling the whole stack
# in a small scratch copy, preserving source timestamps on an idempotent run.
if(BUILD_DIR)
    set(scratch_parent "${BUILD_DIR}")
else()
    set(scratch_parent "${CMAKE_CURRENT_BINARY_DIR}")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(scratch "${scratch_parent}/managed-patch-check-${nonce}")
file(MAKE_DIRECTORY "${scratch}")
execute_process(COMMAND git -C "${scratch}" init --quiet COMMAND_ERROR_IS_FATAL ANY)
foreach(relative IN LISTS affected_paths)
    if(EXISTS "${SOURCE_DIR}/${relative}")
        get_filename_component(parent "${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${scratch}/${parent}")
        file(COPY "${SOURCE_DIR}/${relative}" DESTINATION "${scratch}/${parent}")
    endif()
endforeach()
set(all_applied TRUE)
foreach(patch IN LISTS reverse_patches)
    execute_process(COMMAND git -C "${scratch}" apply --reverse --check "${patch}"
        RESULT_VARIABLE recognized OUTPUT_QUIET ERROR_QUIET)
    if(NOT recognized EQUAL 0)
        set(all_applied FALSE)
        break()
    endif()
    execute_process(COMMAND git -C "${scratch}" apply --reverse "${patch}"
        OUTPUT_QUIET ERROR_QUIET COMMAND_ERROR_IS_FATAL ANY)
endforeach()
file(REMOVE_RECURSE "${scratch}")

if(NOT all_applied)
    # Accept pristine trees and previously installed prefixes. Unknown/conflicting
    # edits still fail the forward checks below, without silently skipping code.
    foreach(patch IN LISTS reverse_patches)
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply --reverse --check "${patch}"
            RESULT_VARIABLE recognized OUTPUT_QUIET ERROR_QUIET)
        if(recognized EQUAL 0)
            execute_process(COMMAND git -C "${SOURCE_DIR}" apply --reverse "${patch}"
                COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endforeach()
    foreach(patch IN LISTS PATCH_FILES)
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply --check "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
endif()
if(REMOVE_MANAGED_PATCH)
    foreach(patch IN LISTS reverse_patches)
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply --reverse "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    if(BUILD_DIR)
        file(REMOVE "${metadata}")
    endif()
elseif(BUILD_DIR)
    file(MAKE_DIRECTORY "${BUILD_DIR}")
    file(WRITE "${metadata}" "${patch_metadata}")
endif()
message(STATUS "Managed llama.cpp patch stack checked (${revision})")
