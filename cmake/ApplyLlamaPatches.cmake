cmake_minimum_required(VERSION 3.19)
if(NOT SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(metadata "${BUILD_DIR}/ezlocalai-llama-cpp-patches.txt")
# Custom engine revisions retain their own behavior. The patches are qualified
# against this exact upstream pin, independently of the chosen platform.
if(NOT revision STREQUAL "620d2225cc436ab0b001e3200e590e3b286ef9ab")
    if(BUILD_DIR)
        file(REMOVE "${metadata}")
    endif()
    message(STATUS "Custom llama.cpp revision: managed patches not applied")
    return()
endif()
if(NOT PATCH_FILES)
    if(PATCH_FILE)
        # Preserve the original single-patch entrypoint used by the build tool,
        # and discover the rest of the managed stack beside that patch.
        get_filename_component(patch_dir "${PATCH_FILE}" DIRECTORY)
    else()
        set(patch_dir "${CMAKE_CURRENT_LIST_DIR}")
        if(NOT EXISTS "${patch_dir}/llama-conversation-cache.patch")
            set(patch_dir "${CMAKE_CURRENT_LIST_DIR}/../patches")
        endif()
        set(PATCH_FILE "${patch_dir}/llama-conversation-cache.patch")
    endif()
    set(PATCH_FILES "${PATCH_FILE}" "${patch_dir}/llama-state-io-batching.patch")
endif()
if(REMOVE_MANAGED_PATCH)
    list(REVERSE PATCH_FILES)
endif()
set(patch_metadata "")
foreach(patch IN LISTS PATCH_FILES)
    if(NOT EXISTS "${patch}")
        message(FATAL_ERROR "Missing managed llama.cpp patch: ${patch}")
    endif()
    execute_process(COMMAND git -C "${SOURCE_DIR}" apply --reverse --check "${patch}"
        RESULT_VARIABLE already_applied OUTPUT_QUIET ERROR_QUIET)
    if(REMOVE_MANAGED_PATCH)
        if(already_applied EQUAL 0)
            execute_process(COMMAND git -C "${SOURCE_DIR}" apply --reverse "${patch}" COMMAND_ERROR_IS_FATAL ANY)
        else()
            execute_process(COMMAND git -C "${SOURCE_DIR}" apply --check "${patch}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
        continue()
    endif()
    if(NOT already_applied EQUAL 0)
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply --check "${patch}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND git -C "${SOURCE_DIR}" apply "${patch}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    file(SHA256 "${patch}" patch_sha256)
    get_filename_component(patch_name "${patch}" NAME_WE)
    string(APPEND patch_metadata "patch.${patch_name}=${patch_sha256}\n")
    message(STATUS "Managed ${patch_name} patch: ${patch_sha256}")
endforeach()
if(BUILD_DIR)
    if(REMOVE_MANAGED_PATCH)
        file(REMOVE "${metadata}")
    else()
        file(MAKE_DIRECTORY "${BUILD_DIR}")
        file(WRITE "${metadata}" "${patch_metadata}")
    endif()
endif()
