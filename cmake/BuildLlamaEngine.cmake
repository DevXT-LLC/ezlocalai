# Build the pinned engine independently of API sources. Keep the same paths
# and revision metadata used by llama_cpp_tool and the native TTS worker.
cmake_minimum_required(VERSION 3.19)
set(source /app/third_party/llama.cpp)
set(build /app/build/llama.cpp)
set(repo "$ENV{EZLOCALAI_LLAMA_CPP_REPO}")
set(ref "$ENV{EZLOCALAI_LLAMA_CPP_REF}")
if(NOT repo OR NOT ref)
    message(FATAL_ERROR "llama.cpp repository and revision must be configured")
endif()
execute_process(COMMAND git clone "${repo}" "${source}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git -C "${source}" fetch --tags --prune origin COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git -C "${source}" checkout "${ref}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git -C "${source}" rev-parse HEAD OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git -C "${source}" show -s --format=%cI HEAD OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(MAKE_DIRECTORY "${build}")
file(WRITE "${build}/ezlocalai-llama-cpp-version.txt" "repo=${repo}\nref=${ref}\nsha=${sha}\ndate=${date}\n")
separate_arguments(extra UNIX_COMMAND "$ENV{EZLOCALAI_LLAMA_CPP_CMAKE_ARGS}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${build}" -DCMAKE_BUILD_TYPE=Release ${extra} COMMAND_ERROR_IS_FATAL ANY)
set(jobs "$ENV{EZLOCALAI_LLAMA_CPP_JOBS}")
if(NOT jobs)
    include(ProcessorCount)
    ProcessorCount(jobs)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target llama-server --parallel "${jobs}" COMMAND_ERROR_IS_FATAL ANY)
