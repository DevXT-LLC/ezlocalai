# Extract only native headers, libraries, model assets and licenses from
# checksum-pinned upstream distributions. No Python interpreter is used.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED DESTINATION)
    message(FATAL_ERROR "Set DESTINATION to the native dependency directory")
endif()
if(NOT DEFINED DOWNLOAD_CACHE)
    set(DOWNLOAD_CACHE "${DESTINATION}/downloads")
endif()
file(MAKE_DIRECTORY "${DESTINATION}/lib" "${DESTINATION}/licenses" "${DOWNLOAD_CACHE}")
# MANIFEST selects checksum-pinned CUDA, ROCm or CPU platform dependencies.
if(NOT DEFINED MANIFEST)
    set(MANIFEST "${CMAKE_CURRENT_LIST_DIR}/cuda-audio-dependencies.json")
endif()
file(READ "${MANIFEST}" dependencies)
set(ctranslate2_library "")
set(sndfile_library "")
string(JSON count LENGTH "${dependencies}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    foreach(field name kind url sha256)
        string(JSON ${field} GET "${dependencies}" ${index} ${field})
    endforeach()
    set(archive "${DOWNLOAD_CACHE}/${name}.archive")
    set(valid FALSE)
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual_hash)
        if(actual_hash STREQUAL sha256)
            set(valid TRUE)
        endif()
    endif()
    if(NOT valid)
        message(STATUS "Downloading ${name}")
        file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Download failed for ${name}: ${status}")
        endif()
    endif()
    set(extract "${DOWNLOAD_CACHE}/extract")
    file(REMOVE_RECURSE "${extract}")
    file(MAKE_DIRECTORY "${extract}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
    if(kind STREQUAL "ct2_headers")
        file(COPY "${extract}/CTranslate2-4.8.2/include/" DESTINATION "${DESTINATION}/ctranslate2/include")
    elseif(kind STREQUAL "ct2")
        file(COPY "${extract}/ctranslate2.libs/" DESTINATION "${DESTINATION}/lib")
        file(GLOB found RELATIVE "${extract}/ctranslate2.libs" "${extract}/ctranslate2.libs/libctranslate2-*.so.*")
        list(GET found 0 ctranslate2_library)
        set(ctranslate2_library "${DESTINATION}/lib/${ctranslate2_library}")
    elseif(kind STREQUAL "ort")
        file(GLOB release LIST_DIRECTORIES true "${extract}/onnxruntime-linux-*")
        file(COPY "${release}/include/" DESTINATION "${DESTINATION}/onnxruntime/include")
        file(GLOB libraries "${release}/lib/*.so*")
        file(COPY ${libraries} DESTINATION "${DESTINATION}/lib")
    elseif(kind STREQUAL "ort_library")
        # Use the exact native build in the installed reference; the release
        # tarball above supplies matching public headers and SONAME symlinks.
        file(GLOB libraries "${extract}/onnxruntime/capi/libonnxruntime*.so*")
        file(COPY ${libraries} DESTINATION "${DESTINATION}/lib")
    elseif(kind STREQUAL "torch")
        file(COPY "${extract}/torch/include" DESTINATION "${DESTINATION}/torch")
        file(COPY "${extract}/torch/share/cmake" DESTINATION "${DESTINATION}/torch/share")
        file(GLOB libraries "${extract}/torch/lib/*.so*")
        # Do not ship the Python binding or the libtorch.so compatibility shim.
        list(FILTER libraries EXCLUDE REGEX "/libtorch(_python)?[.]so$")
        file(COPY ${libraries} DESTINATION "${DESTINATION}/torch/lib")
        # ARM CPU wheels bundle BLAS/Arm Compute dependencies beside torch.
        # Preserve that layout for libtorch_cpu's $ORIGIN/../../torch.libs
        # RPATH, including the bundled libraries' own relative dependencies.
        if(IS_DIRECTORY "${extract}/torch.libs")
            file(COPY "${extract}/torch.libs" DESTINATION "${DESTINATION}")
            # Bundled BLAS has no RPATH of its own. Expose these SONAMEs in
            # the existing Torch library search directory as well, so native
            # linkers can resolve its indirect Fortran/OpenMP dependencies.
            file(GLOB bundled_libraries RELATIVE "${extract}/torch.libs" "${extract}/torch.libs/*.so*")
            foreach(library IN LISTS bundled_libraries)
                file(CREATE_LINK "../../torch.libs/${library}" "${DESTINATION}/torch/lib/${library}" SYMBOLIC)
            endforeach()
        endif()
        # ROCm kernels are separate native data assets loaded at runtime.
        # Copy them with the libraries; top-level .so files alone cannot run.
        foreach(kernel_directory rocblas hipblaslt hipsparselt aotriton.images)
            if(IS_DIRECTORY "${extract}/torch/lib/${kernel_directory}")
                file(COPY "${extract}/torch/lib/${kernel_directory}" DESTINATION "${DESTINATION}/torch/lib")
            endif()
        endforeach()
        # Wheels can preload libraries from Python under an unversioned name.
        # Native executables instead need the pinned ELF SONAME aliases.
        string(JSON soname_count ERROR_VARIABLE soname_error LENGTH "${dependencies}" ${index} soname_links)
        if(NOT soname_error AND soname_count GREATER 0)
            math(EXPR soname_last "${soname_count} - 1")
            foreach(soname_index RANGE ${soname_last})
                string(JSON soname MEMBER "${dependencies}" ${index} soname_links ${soname_index})
                string(JSON library GET "${dependencies}" ${index} soname_links "${soname}")
                file(CREATE_LINK "${library}" "${DESTINATION}/torch/lib/${soname}" SYMBOLIC)
            endforeach()
        endif()
    elseif(kind STREQUAL "vad")
        file(GLOB models "${extract}/faster_whisper/assets/*.onnx")
        file(COPY ${models} DESTINATION "${DESTINATION}/whisper-vad")
    elseif(kind STREQUAL "sndfile")
        file(GLOB found "${extract}/_soundfile_data/libsndfile_*.so")
        file(COPY ${found} DESTINATION "${DESTINATION}/lib")
        get_filename_component(sndfile_library "${found}" NAME)
        set(sndfile_library "${DESTINATION}/lib/${sndfile_library}")
    elseif(kind STREQUAL "cuda")
        file(GLOB_RECURSE libraries "${extract}/nvidia/*.so*")
        file(COPY ${libraries} DESTINATION "${DESTINATION}/lib")
    else()
        message(FATAL_ERROR "Unknown native dependency kind: ${kind}")
    endif()
    file(GLOB_RECURSE notices RELATIVE "${extract}"
        "${extract}/*LICENSE*" "${extract}/*LICENCE*" "${extract}/*COPYING*"
        "${extract}/*NOTICE*" "${extract}/*Notices*" "${extract}/*license*")
    foreach(notice IN LISTS notices)
        get_filename_component(parent "${notice}" DIRECTORY)
        file(COPY "${extract}/${notice}" DESTINATION "${DESTINATION}/licenses/${name}/${parent}")
    endforeach()
    file(REMOVE_RECURSE "${extract}")
endforeach()
file(COPY "${MANIFEST}" DESTINATION "${DESTINATION}")
# A CUDA CTranslate2 built from source (GB10: the aarch64 wheel is CPU-only)
# is installed in its own stage; its final paths are passed in here.
if(DEFINED CTRANSLATE2_LIBRARY)
    set(ctranslate2_library "${CTRANSLATE2_LIBRARY}")
endif()
if(NOT DEFINED CTRANSLATE2_INCLUDE_DIR)
    set(CTRANSLATE2_INCLUDE_DIR "${DESTINATION}/ctranslate2/include")
endif()
if(NOT ctranslate2_library OR NOT sndfile_library)
    message(FATAL_ERROR "Manifest must provide CTranslate2 (or CTRANSLATE2_LIBRARY) and libsndfile")
endif()
file(WRITE "${DESTINATION}/native-cache.cmake" "
set(EZLOCALAI_CTRANSLATE2_INCLUDE_DIR \"${CTRANSLATE2_INCLUDE_DIR}\" CACHE PATH \"\" FORCE)
set(EZLOCALAI_CTRANSLATE2_LIBRARY \"${ctranslate2_library}\" CACHE FILEPATH \"\" FORCE)
set(EZLOCALAI_CTRANSLATE2_LEGACY_ABI OFF CACHE BOOL \"\" FORCE)
set(EZLOCALAI_ONNXRUNTIME_INCLUDE_DIR \"${DESTINATION}/onnxruntime/include\" CACHE PATH \"\" FORCE)
set(EZLOCALAI_ONNXRUNTIME_LIBRARY \"${DESTINATION}/lib/libonnxruntime.so\" CACHE FILEPATH \"\" FORCE)
set(EZLOCALAI_LIBTORCH_ROOT \"${DESTINATION}/torch\" CACHE PATH \"\" FORCE)
set(EZLOCALAI_CUDA_INCLUDE_DIRS \"/usr/local/cuda/include\" CACHE STRING \"\" FORCE)
set(EZLOCALAI_STT_CUDA_LIBRARY_PATH \"${DESTINATION}/lib:${DESTINATION}/torch/lib\" CACHE STRING \"\" FORCE)
set(EZLOCALAI_WHISPER_VAD_MODERN_MODELS \"${DESTINATION}/whisper-vad\" CACHE PATH \"\" FORCE)
set(EZLOCALAI_SNDFILE_LIBRARY \"${sndfile_library}\" CACHE FILEPATH \"\" FORCE)
")
