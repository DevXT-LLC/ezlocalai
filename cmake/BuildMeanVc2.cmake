cmake_minimum_required(VERSION 3.20)
# Standalone CPU engine: a separate executable with static ggml avoids ABI
# collisions and reserves the worker's GPU for LFM. No weights enter the image.
foreach(name WRAPPER PREFIX)
    if(NOT EZLOCALAI_MEANVC2_${name})
        message(FATAL_ERROR "Set EZLOCALAI_MEANVC2_${name}")
    endif()
endforeach()
set(revision cd770076152085af5b166521185bec76f9d47808)
if(NOT EZLOCALAI_MEANVC2_SOURCE)
    set(EZLOCALAI_MEANVC2_SOURCE /tmp/ezlocalai-meanvc2-source)
    execute_process(COMMAND git init "${EZLOCALAI_MEANVC2_SOURCE}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND git -C "${EZLOCALAI_MEANVC2_SOURCE}" fetch --depth 1 https://github.com/0xShug0/audio.cpp.git ${revision} COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND git -C "${EZLOCALAI_MEANVC2_SOURCE}" checkout --detach FETCH_HEAD COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND git -C "${EZLOCALAI_MEANVC2_SOURCE}" rev-parse HEAD OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT actual STREQUAL revision)
    message(FATAL_ERROR "Unexpected audio.cpp source revision")
endif()
if(NOT EZLOCALAI_MEANVC2_BUILD)
    set(EZLOCALAI_MEANVC2_BUILD /tmp/ezlocalai-meanvc2-build)
endif()
if(NOT EZLOCALAI_MEANVC2_JOBS)
    set(EZLOCALAI_MEANVC2_JOBS 4)
endif()
set(architecture)
if(EZLOCALAI_ARM_CPU_ARCH)
    list(APPEND architecture "-DGGML_CPU_ARM_ARCH=${EZLOCALAI_ARM_CPU_ARCH}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${EZLOCALAI_MEANVC2_WRAPPER}" -B "${EZLOCALAI_MEANVC2_BUILD}"
    "-DEZLOCALAI_AUDIOCPP_SOURCE=${EZLOCALAI_MEANVC2_SOURCE}" -DCMAKE_BUILD_TYPE=Release
    "-DCMAKE_INSTALL_PREFIX=${EZLOCALAI_MEANVC2_PREFIX}"
    -DENGINE_ENABLE_CUDA=OFF -DENGINE_ENABLE_HIP=OFF -DENGINE_ENABLE_NATIVE_CPU=OFF ${architecture}
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${EZLOCALAI_MEANVC2_BUILD}" --target ezlocalai-meanvc2 --parallel ${EZLOCALAI_MEANVC2_JOBS} COMMAND_ERROR_IS_FATAL ANY)
# Only our executable is installed; upstream's many optional applications stay out.
file(MAKE_DIRECTORY "${EZLOCALAI_MEANVC2_PREFIX}/bin" "${EZLOCALAI_MEANVC2_PREFIX}/licenses")
file(COPY "${EZLOCALAI_MEANVC2_BUILD}/bin/ezlocalai-meanvc2" DESTINATION "${EZLOCALAI_MEANVC2_PREFIX}/bin")
file(COPY "${EZLOCALAI_MEANVC2_SOURCE}/LICENSE" DESTINATION "${EZLOCALAI_MEANVC2_PREFIX}/licenses")
foreach(component ggml sentencepiece libyaml cJSON)
    file(GLOB notices "${EZLOCALAI_MEANVC2_SOURCE}/external/${component}/LICENSE*" "${EZLOCALAI_MEANVC2_SOURCE}/external/${component}/COPYING*")
    if(notices)
        file(MAKE_DIRECTORY "${EZLOCALAI_MEANVC2_PREFIX}/licenses/${component}")
        file(COPY ${notices} DESTINATION "${EZLOCALAI_MEANVC2_PREFIX}/licenses/${component}")
    endif()
endforeach()
execute_process(COMMAND "${EZLOCALAI_MEANVC2_PREFIX}/bin/ezlocalai-meanvc2" --version COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${EZLOCALAI_MEANVC2_PREFIX}/version.txt" "audio.cpp ${revision}\nMeanVC2 F32, CPU, GGML_NATIVE=OFF, speaker-cache reference-v1\n")
