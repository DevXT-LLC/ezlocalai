# Font libraries from the pinned Pillow distribution and its bundled Raqm
# source. Brotli is overlaid with the patched system package, preserving the
# wheel filenames expected by FreeType. No Python interpreter enters the output.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED DESTINATION)
    message(FATAL_ERROR "Set DESTINATION to the storyboard dependency directory")
endif()
if(NOT DEFINED DOWNLOAD_CACHE)
    set(DOWNLOAD_CACHE "${DESTINATION}/downloads")
endif()
find_program(C_COMPILER gcc REQUIRED)
file(MAKE_DIRECTORY "${DESTINATION}/lib" "${DESTINATION}/include" "${DESTINATION}/licenses" "${DOWNLOAD_CACHE}")
if(NOT DEFINED MANIFEST)
    set(MANIFEST "${CMAKE_CURRENT_LIST_DIR}/storyboard-dependencies.json")
endif()
file(READ "${MANIFEST}" dependencies)
string(JSON count LENGTH "${dependencies}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    foreach(field name kind url sha256)
        string(JSON ${field} GET "${dependencies}" ${index} ${field})
    endforeach()
    set(archive "${DOWNLOAD_CACHE}/${name}.archive")
    set(valid FALSE)
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual_hash)
        if(actual_hash STREQUAL sha256)
            set(valid TRUE)
        endif()
    endif()
    if(NOT valid)
        file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Download failed for ${name}: ${status}")
        endif()
    endif()
    set(extract "${DOWNLOAD_CACHE}/extract-storyboard")
    file(REMOVE_RECURSE "${extract}")
    file(MAKE_DIRECTORY "${extract}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
    if(kind STREQUAL "libraries")
        # The other wheel libraries (codecs, X11, etc.) are not font dependencies.
        foreach(stem freetype harfbuzz png16 brotlidec brotlicommon)
            file(GLOB library "${extract}/pillow.libs/lib${stem}-*.so.*")
            list(LENGTH library matches)
            if(NOT matches EQUAL 1)
                message(FATAL_ERROR "Expected one pinned ${stem} library")
            endif()
            if(stem STREQUAL "brotlidec" OR stem STREQUAL "brotlicommon")
                # Pillow's wheel carries its own decoder under hashed filenames.
                # Replacing only the system package would leave that copy exposed.
                find_program(PKG_CONFIG_EXECUTABLE pkg-config REQUIRED)
                execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --atleast-version=1.2.1 libbrotlidec
                    COMMAND_ERROR_IS_FATAL ANY)
                execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --variable=libdir libbrotlidec
                    OUTPUT_VARIABLE patched_brotli_libdir OUTPUT_STRIP_TRAILING_WHITESPACE
                    COMMAND_ERROR_IS_FATAL ANY)
                get_filename_component(wheel_filename "${library}" NAME)
                file(COPY_FILE "${patched_brotli_libdir}/lib${stem}.so.1"
                    "${DESTINATION}/lib/${wheel_filename}")
            else()
                file(COPY ${library} DESTINATION "${DESTINATION}/lib")
            endif()
        endforeach()
    elseif(kind STREQUAL "raqm")
        set(raqm "${extract}/pillow-12.3.0/src/thirdparty/raqm")
        file(COPY "${raqm}/raqm.h" "${raqm}/raqm-version.h" DESTINATION "${DESTINATION}/include")
        file(GLOB freetype "${DESTINATION}/lib/libfreetype-*.so.*")
        file(GLOB harfbuzz "${DESTINATION}/lib/libharfbuzz-*.so.*")
        execute_process(COMMAND "${C_COMPILER}" -shared -fPIC -O2 -DHAVE_FRIBIDI_SYSTEM
            -I/usr/include/freetype2 -I/usr/include/harfbuzz -I/usr/include/fribidi
            "${raqm}/raqm.c" ${freetype} ${harfbuzz} -lfribidi
            "-Wl,-rpath,$ORIGIN" -Wl,-soname,libraqm.so.0
            -o "${DESTINATION}/lib/libraqm.so.0" COMMAND_ERROR_IS_FATAL ANY)
    else()
        message(FATAL_ERROR "Unknown storyboard dependency kind: ${kind}")
    endif()
    file(GLOB_RECURSE notices RELATIVE "${extract}"
        "${extract}/*LICENSE*" "${extract}/*LICENCE*" "${extract}/*COPYING*"
        "${extract}/*NOTICE*" "${extract}/*license*")
    foreach(notice IN LISTS notices)
        get_filename_component(parent "${notice}" DIRECTORY)
        file(COPY "${extract}/${notice}" DESTINATION "${DESTINATION}/licenses/${name}/${parent}")
    endforeach()
    file(REMOVE_RECURSE "${extract}")
endforeach()
# System development headers and FriBidi are ABI-compatible with the pinned
# libraries. Carry these into the worker without installing Python packages.
file(COPY /usr/include/freetype2 DESTINATION "${DESTINATION}/include")
file(GLOB fribidi "/usr/lib/*-linux-gnu/libfribidi.so.0*")
file(COPY ${fribidi} DESTINATION "${DESTINATION}/lib")
foreach(package libfribidi0 libfreetype-dev fonts-dejavu-core libbrotli1)
    file(COPY "/usr/share/doc/${package}/copyright" DESTINATION "${DESTINATION}/licenses/${package}")
endforeach()
foreach(font DejaVuSans DejaVuSans-Bold)
    if(font STREQUAL "DejaVuSans")
        set(expected ae7b7855e115a5966d8b1b3f80f254ccc117ec86f9965e202ee2940453837280)
    else()
        set(expected 5c1247acef7f2b8522a31742c76d6adcb5569bacc0be7ceaa4dc39dd252ce895)
    endif()
    set(path "/usr/share/fonts/truetype/dejavu/${font}.ttf")
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${font} differs from the Python reference font")
    endif()
    file(COPY "${path}" DESTINATION "${DESTINATION}/fonts")
endforeach()
file(COPY "${MANIFEST}" DESTINATION "${DESTINATION}")
